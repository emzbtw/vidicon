---
// The landing page's feature cards: one per bullet of the README's
// "What it does", each opening its screenshot from docs/screenshots/.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { whatItDoes } from '../../readme-pages.mjs';
import readme from '../../../README.md?raw';

const shots = import.meta.glob<ImageMetadata>('../../../docs/screenshots/*.png', { eager: true, import: 'default' });

// A card for each README bullet, matched by how the bullet starts. A bullet
// with no card, or a card with no bullet, fails the build.
const CARDS = [
	{ starts: 'Live channels', title: 'Live channels', shot: 'main-guide.png', alt: "The main screen: categories, channels with what is on now, and the selected channel's guide" },
	{ starts: 'A guide grid', title: 'Guide grid', shot: 'guide-grid.png', alt: 'The guide grid: channels down the side, programmes along a timeline' },
	{ starts: 'Fuzzy search', title: 'Search', shot: 'search-all-kinds.png', alt: 'Search across channels, movies and series' },
	{ starts: 'Favourites', title: 'Favourites and history', shot: 'recently-played.png', alt: 'Recently played channels, with favourites starred' },
	{ starts: 'Catch-up', title: 'Catch-up', shot: 'guide-catch-up.png', alt: 'The guide grid with an ended programme selected and marked catch-up' },
	{ starts: 'Scheduled recordings', title: 'Recordings', shot: 'recordings.png', alt: 'The recordings panel: one recording now, two scheduled, and the history' },
	{ starts: 'Movies and series', title: 'Movies and series', shot: 'movies.png', alt: "Movies, with a selected movie's details and where to resume it" },
	{ starts: 'External XMLTV', title: 'Guide sources', shot: 'guide-mapping.png', alt: 'Mapping a channel to a guide source channel by searching its ids and names' },
	{ starts: 'Reconnects', title: 'Stream recovery', shot: 'other-listings.png', alt: "A channel's details with its other listing, ready to play instead" },
	{ starts: 'Colours from your Noctalia', title: 'Themes', shot: 'themes.png', alt: 'The main screen split diagonally between two Noctalia palettes, one orange, one magenta' },
	{ starts: 'Keyboard first', title: 'Keyboard first', shot: 'keys.png', alt: 'The keys panel, listing every key' },
];

const features = whatItDoes(readme).map((text, i) => {
	// A card prints the bullet as text, and is itself a link, so Markdown
	// or HTML in a bullet fails the build rather than showing as symbols.
	if (/[*_`[\]<]/.test(text)) throw new Error(`README bullet "${text}" has Markdown or HTML; feature cards show plain text`);
	const card = CARDS.find((c) => text.startsWith(c.starts));
	if (!card) throw new Error(`No feature card for README bullet "${text}"`);
	const image = shots[`../../../docs/screenshots/${card.shot}`];
	if (!image) throw new Error(`No screenshot docs/screenshots/${card.shot}`);
	return { ...card, text, image, id: `feature-${i}` };
});
for (const card of CARDS) {
	if (!features.some((f) => f.starts === card.starts)) throw new Error(`Feature card "${card.title}" matches no README bullet`);
}
---

<ul class="features not-content">
	{
		features.map((f) => (
			<li>
				<a class="feature" href={f.image.src} data-dialog={f.id}>
					<Image class="thumb" src={f.image} alt="" widths={[480, 960]} sizes="20rem" />
					<strong>{f.title}</strong>
					<span>{f.text}</span>
				</a>
				<dialog id={f.id} aria-label={f.title}>
					<form method="dialog">
						<button aria-label="Close">×</button>
					</form>
					<Image src={f.image} alt={f.alt} widths={[960, f.image.width]} sizes="95vw" />
					<p>{f.text}</p>
				</dialog>
			</li>
		))
	}
</ul>

<script>
	// Without script, a card links to its screenshot file.
	for (const link of document.querySelectorAll<HTMLAnchorElement>('.feature')) {
		const dialog = document.getElementById(link.dataset.dialog!) as HTMLDialogElement;
		link.addEventListener('click', (event) => {
			event.preventDefault();
			dialog.showModal();
		});
		// A click on the backdrop, outside the dialog's box, closes it.
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
	}
</script>

<style>
	.features {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
		gap: 1rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.feature {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		height: 100%;
		padding: 0 1.25rem 1rem;
		overflow: hidden;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	/* A preview of the card's screenshot, cropped from its top left. */
	.feature .thumb {
		width: calc(100% + 2.5rem);
		max-width: none;
		height: auto;
		aspect-ratio: 16 / 9;
		margin: 0 -1.25rem 0.5rem;
		object-fit: cover;
		object-position: top left;
		border-bottom: 1px solid var(--sl-color-gray-5);
	}
	.feature:hover,
	.feature:focus-visible {
		border-color: var(--sl-color-accent);
	}
	.feature strong {
		color: var(--sl-color-white);
		font-size: var(--sl-text-lg);
		font-variation-settings: 'opsz' 32;
	}
	/* The dialog shrinks to the image, which fits the viewport's height. */
	dialog {
		width: fit-content;
		max-width: 95vw;
		max-height: 95vh;
		/* Starlight's reset drops the default centring. */
		margin: auto;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
	}
	dialog::backdrop {
		background: rgb(0 0 0 / 0.75);
	}
	dialog img {
		display: block;
		width: auto;
		max-width: 100%;
		max-height: calc(95vh - 7rem);
		height: auto;
		border-radius: 0.25rem;
	}
	/* The caption wraps to the image's width rather than widening it. */
	dialog p {
		width: 0;
		min-width: calc(100% - 0.5rem);
		margin: 0.75rem 0.25rem 0.25rem;
	}
	dialog form {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 0.5rem;
	}
	dialog button {
		width: 2rem;
		height: 2rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.25rem;
		background: none;
		color: var(--sl-color-white);
		font-size: 1.25rem;
		line-height: 1;
		cursor: pointer;
	}
</style>
