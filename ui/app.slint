// Main screen (SPEC 8.2): category sidebar | channel list | detail panel.
// All state lives in Rust; this file lays it out and forwards input.
import { ListView } from "std-widgets.slint";

// `now` is the airing programme's title, or a placeholder when `has-now` is false.
// `available` is false for a favourite the provider no longer lists: dimmed.
// `initials` on a `tile` colour stand in for the logo while `logo` is empty.
// A channel, or with `poster` a movie or series: `now` is then its year
// and rating (VOD ticket 03).
export struct ChannelItem { num: string, name: string, now: string, progress: float, has-now: bool, favourite: bool, available: bool, initials: string, tile: color, logo: image, poster: bool }
export struct RecentItem { num: string, name: string, initials: string, tile: color, logo: image }
// The NOW PLAYING card, shown while mpv runs (`visible`). With a guide,
// `span` is "19:30 – 20:00" and `left` "2 min left"; without, `span` is
// "Watching for 12 min" and there is no bar. `heading` is "NOW PLAYING",
// "PAUSED", or how far behind live (`behind`), e.g. "BEHIND LIVE · 2 min",
// or "CATCH-UP" while a past programme plays (`catch-up`, also `behind`).
// `recording` is "● REC 0:12" while `R` records it, else empty.
// `start-over` is the `S` hint while live on a channel with an archive and
// a guide (catch-up ticket 04), else empty.
// A `movie` (VOD ticket 04): `title` is its year and rating, `span` its
// position and length from mpv ("0:12:34 / 1:33:14"), and the bar shows
// once the length is known (`has-guide`); no go live or record. Its
// `start-over` is always there, as `S` takes it back to 0 (ticket 07).
export struct PlayingItem {
    visible: bool,
    heading: string,
    behind: bool,
    catch-up: bool,
    movie: bool,
    name: string,
    initials: string,
    tile: color,
    logo: image,
    title: string,
    has-guide: bool,
    span: string,
    left: string,
    progress: float,
    paused: bool,
    muted: bool,
    fullscreen: bool,
    recording: string,
    start-over: string,
}
export enum PlayerControl { pause, live, record, stop, mute, fullscreen }
// How close the account's expiry is (SPEC 6.3): warn within 7 days, danger
// within 3, and once expired or disabled.
export enum Urgency { none, warn, danger }
export struct CategoryItem { name: string }
// A category in manage mode (ticket 20); `overridden` when its own override,
// not the rules, shows or hides it.
// `channels` reads `15 of 20` once name rules hide some.
export struct ManageItem { name: string, shown: bool, overridden: bool, channels: string }
// A channel name rule (ticket 25) and how many channels in shown categories
// it hides.
export struct NameRuleItem { pattern: string, hidden: int }
// A provider in the picker; `note` is its last refresh state.
export struct ProviderItem { name: string, note: string }
export struct LaterItem { time: string, title: string }
// Another listing of the selected channel (stream recovery ticket 03):
// its number, name and category.
export struct AlternateItem { num: string, name: string, category: string }
// A movie's or series' detail, e.g. Cast and its names.
export struct FactItem { label: string, value: string }
// An episode in a series' detail panel (VOD ticket 05): `num` "4", `title`
// its name, `length` "48 min"; either may be empty.
// An episode in a series' panel: `watched` marks it, and `has-progress`
// shows how far it was played (VOD ticket 07).
// `download` is its download's mark (VOD ticket 10): `↓ Downloaded`,
// `↓ 41 %`, `↓ Queued`, `↓ Failed`, or empty.
export struct EpisodeItem { num: string, title: string, length: string, watched: bool, has-progress: bool, progress: float, download: string }
// A programme's recording in the guide grid (recording ticket 03).
export enum RecMark { none, scheduled, recording }
// A programme in the guide grid: `x` and `w` in timeline widths from the
// grid's origin (set when it opens), which `guide-offset` places. `airing`
// is the one on now; `start` its start in seconds from the origin, which
// `GuideSel` matches; `rec` whether it is scheduled or recording. A past
// one the channel's archive keeps has the `archive` mark (catch-up ticket
// 03); one it does not is `gone`, dimmed.
export struct GuideBlock { title: string, times: string, x: float, w: float, airing: bool, start: int, rec: RecMark, archive: bool, gone: bool }
// The grid's selected cell: on `row`, the block with this `start`, or for
// a gap, one drawn at `x` and `w` (as a block's).
export struct GuideSel { row: int, start: int, gap: bool, x: float, w: float }
// The guide grid's detail strip: the selected programme, or a gap with
// only `channel` and `title`. `airing` while it is on now. `record` is
// `Recording` or `Scheduled to record` with the padded times, else empty.
// `replay` is the catch-up hint on a programme the archive keeps.
export struct GuideDetail { channel: string, title: string, times: string, replay: string, description: string, airing: bool, record: string }
// A half-hour tick in the guide grid's header, `x` 0 to 1 across the
// timeline.
export struct GuideTick { label: string, x: float }
// A guide grid row: the channel, then its programmes in the span shown.
export struct GuideItem { num: string, name: string, favourite: bool, initials: string, tile: color, logo: image, blocks: [GuideBlock] }
// A line of the Recordings view (recording ticket 04): a group's `heading`,
// or a recording with that empty. `title` is the programme (the channel
// without a guide), `sub` the channel and times, `note` why it failed or
// was cut short, `state` its state or the file's size. On the Downloads
// tab (VOD ticket 10) a line is a download, `active` while it runs, with
// `progress` 0 to 1 for its bar, or -1 for none.
export enum RecTone { none, recording, warn, dim, active }
export struct RecordingItem { id: int, heading: string, title: string, sub: string, note: string, state: string, tone: RecTone, progress: float }
// The keys panel (ticket 24): columns of groups of rows, each row keycaps
// and what they do. `notes` are the other views, one line each.
// A field in the Settings view (settings ticket 01): a toggle between its
// options, a picker of them, text typed in, or a stepper of minutes
// (`chosen`; settings ticket 02), or a row that does something on Enter
// (onboarding ticket 01). `note` is its key in config.toml and what it
// does; `error` why a save failed, and `button` the fix offered beside it
// (`Create it`, `Save anyway`), if any. `reveal` is `Show` or `Hide` on a
// masked field.
export enum SettingKind { toggle, choice, text, stepper, row }
export struct SettingItem { label: string, note: string, value: string, kind: SettingKind, options: [string], chosen: int, error: string, button: string, reveal: string }

export struct KeyRow { keys: [string], action: string }
export struct KeyGroup { title: string, rows: [KeyRow] }
export struct KeyColumn { groups: [KeyGroup] }
export struct KeyNote { view: string, text: string }
// The refresh panel (refresh panel ticket 01): one row per stage, `state`
// as `✓ 58k` or `▸ 41 %`, and a failed stage's `reason`. A guide source's
// row (`source`) sits indented under EPG (EPG sources ticket 04).
export enum StageTone { waiting, running, done, warn }
// A row of the guide card (EPG sources ticket 05): a source in the `E`
// card, a feed channel in the mapping picker, a channel in the ambiguous
// list. `mark` shows on the right, in accent; `warn` puts the note in amber;
// `action` is a button at the row's end (Pin, Unpin).
export struct CardRow { label: string, note: string, mark: string, warn: bool, action: string }
export struct StageItem { name: string, state: string, tone: StageTone, reason: string, source: bool }
// The account dashboard (ticket 21). Empty strings are rows the provider
// did not send; `status` empty hides the chip, `ok` colours it.
export struct AccountView {
    title: string,
    status: string,
    ok: bool,
    note: string,
    message: string,
    expires: string,
    created: string,
    trial: string,
    connections: string,
    formats: string,
    timezone: string,
    server-time: string,
    ports: string,
    protocol: string,
}

global Palette {
    out property <color> bg: #0e1014;
    out property <color> surface: #151920;
    out property <color> surface-2: #1c212a;
    out property <color> line: #262c37;
    out property <color> text: #e7e9ee;
    out property <color> dim: #8b93a4;
    out property <color> accent: #7c9cff;
    out property <color> accent-dim: #7c9cff2e;
    out property <color> warn: #e8a86b;
    out property <color> danger: #ef6b6b;
    out property <color> danger-dim: #ef6b6b2e;
    out property <color> star: #f2c14e;
    out property <color> ok: #6fcf97;
    // Behind logos: mid grey, so white and dark logos both stay visible.
    out property <color> logo-backing: #3a404c;
}

component Progress inherits Rectangle {
    in property <float> value;
    height: 3px;
    border-radius: 1.5px;
    background: Palette.line;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: parent.border-radius;
        background: Palette.accent;
    }
}

// The channel's logo, fitted and centred on a neutral backing; until it
// loads, or if it cannot, its initials on a colour tile. The logo arrives
// sized for the whole box and is clipped to its rounded corners.
component LogoTile inherits Rectangle {
    in property <string> initials;
    in property <color> tile;
    in property <image> logo;
    in property <length> size: 32px;
    // A poster is 2:3, `size` high (VOD ticket 03).
    in property <bool> poster;
    width: poster ? size * 2 / 3 : size;
    height: size;
    border-radius: poster ? size * 0.08 : size * 0.22;
    background: logo.width > 0 ? Palette.logo-backing : tile;
    clip: true;
    Image {
        width: root.width;
        height: size;
        source: logo;
        image-fit: contain;
    }
    Text {
        text: logo.width > 0 ? "" : initials;
        font-family: "Inter Display";
        font-size: poster ? size * 0.26 : size * 0.36;
        font-weight: 700;
        color: #ffffffe6;
    }
}

// A borderless player control: an icon, soft hover and press, an accent
// tint while its toggle is on.
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> on;
    // While `on`: the record button is red, as `● REC` is.
    in property <color> on-ink: Palette.accent;
    in property <color> on-fill: Palette.accent-dim;
    // Shown but does nothing, so the buttons beside it never shift.
    in property <bool> dimmed;
    callback clicked();
    width: 40px;
    height: 34px;
    border-radius: 8px;
    background: on ? on-fill : area.pressed ? #ffffff1a : area.has-hover ? #ffffff0f : transparent;
    area := TouchArea {
        enabled: !dimmed;
        mouse-cursor: dimmed ? MouseCursor.default : MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    Image {
        source: icon;
        width: 18px;
        height: 18px;
        colorize: on ? on-ink : area.has-hover ? Palette.text : #c9cedb;
        opacity: dimmed ? 0.3 : 1;
    }
}

// A small rounded label, e.g. "★ Favourite" or ".ts".
component Chip inherits Rectangle {
    in property <string> text;
    in property <color> ink: Palette.dim;
    in property <color> fill: Palette.surface-2;
    height: 22px;
    width: label.preferred-width + 16px;
    border-radius: 11px;
    background: fill;
    label := Text {
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        color: root.ink;
    }
}

// Section heading in the detail panel.
component Heading inherits Text {
    font-size: 11px;
    font-weight: 600;
    color: Palette.dim;
}

// A label and value row in the account dashboard.
component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    height: 26px;
    spacing: 12px;
    Text {
        width: 130px;
        text: label;
        font-size: 12px;
        color: Palette.dim;
        vertical-alignment: center;
    }
    Text {
        text: value;
        font-size: 13px;
        color: Palette.text;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
}

// A masked login field: dots until clicked. `value` is empty while masked,
// so the secret is not in the window at all until revealed.
component SecretRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> key;
    in property <string> value;
    callback clicked();
    height: 34px;
    padding-top: 2px;
    padding-bottom: 2px;
    spacing: 12px;
    Text {
        width: 130px;
        text: label;
        font-size: 12px;
        color: Palette.dim;
        vertical-alignment: center;
    }
    Rectangle {
        horizontal-stretch: 1;
        border-radius: 6px;
        background: area.has-hover ? Palette.line : Palette.surface-2;
        area := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
        }
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            Text {
                text: value != "" ? value : "••••••••••••";
                font-size: 13px;
                color: value != "" ? Palette.text : Palette.dim;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: key + (value != "" ? "  hide" : "  show");
                font-size: 11px;
                color: Palette.accent;
                vertical-alignment: center;
            }
        }
    }
}

// A key on the keys panel.
component Keycap inherits Rectangle {
    in property <string> text;
    height: 22px;
    width: max(22px, label.preferred-width + 12px);
    border-radius: 5px;
    border-width: 1px;
    border-color: Palette.line;
    background: Palette.surface-2;
    label := Text {
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        color: Palette.text;
    }
}

component SectionHeading inherits Text {
    font-size: 11px;
    font-weight: 600;
    color: Palette.dim;
    letter-spacing: 0.6px;
}

component Divider inherits Rectangle {
    width: 1px;
    height: 14px;
    background: Palette.line;
}

// The window-wide status bar: provider and account | refresh | messages.
// Stays visible in search mode, when the side panes fold away.
component StatusBar inherits Rectangle {
    in property <string> provider;
    in property <string> account;
    in property <Urgency> urgency;
    in property <string> refresh;
    in property <bool> refresh-error;
    in property <bool> refreshing;
    // A refresh ran this session: a click on the state opens its panel.
    in property <bool> refresh-has-panel;
    in property <string> message;
    in property <bool> message-error;
    // mpv is running: the hints include its controls.
    in property <bool> playing;
    // Space resumes rather than pauses.
    in property <bool> paused;
    // Behind live: `L` goes live.
    in property <bool> behind;
    // In search mode, with the panel hidden: what plays, e.g. "▶ Harbour One".
    in property <string> compact-playing;
    // The guide grid is open: `t` goes back to the list, `/` is not there yet.
    in property <bool> guide;
    // "● REC 0:12" while recording, else empty.
    in property <string> recording;
    // A movie plays: nothing to record (VOD ticket 04).
    in property <bool> movie;
    // Keys move in a series' episodes (VOD ticket 05).
    in property <bool> episodes;
    // The library lists movies or series: no search or guide.
    in property <bool> titles;
    callback provider-clicked();
    callback account-clicked();
    // The dot opens the dashboard only where there is an account.
    in property <bool> has-account: true;
    // The sweep line or the refresh state: the refresh panel.
    callback refresh-clicked();
    // The gear: the Settings view.
    callback settings-clicked();

    height: 30px;
    background: Palette.surface;
    Rectangle {
        y: 0;
        height: 1px;
        background: Palette.line;
    }
    // While refreshing, a short accent segment sweeps along the top edge. It
    // exists only then, so an idle window does not redraw (SPEC 10).
    if refreshing : Rectangle {
        y: 0;
        height: 2px;
        width: root.width * 0.2;
        x: root.width * 1.2 * mod(animation-tick(), 1800ms) / 1800ms - self.width;
        background: Palette.accent;
    }
    // The line is 2 px: a strip along it takes the click.
    if refreshing : TouchArea {
        y: 0;
        height: 6px;
        mouse-cursor: MouseCursor.pointer;
        clicked => { refresh-clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 14px;
        // Provider and account. The name opens the picker when there is a
        // choice; the dot and the account open the dashboard.
        Rectangle {
            horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 8px;
                // Health: ok, error, or refreshing. Wrapped so it can be
                // centred; a layout ignores `y` on its own children. The
                // click area takes the bar's padding and half the gap.
                Rectangle {
                    width: 7px;
                    TouchArea {
                        x: -14px;
                        width: 14px + 7px + 4px;
                        enabled: has-account;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { account-clicked(); }
                    }
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3.5px;
                        background: refreshing ? Palette.accent : refresh-error ? Palette.warn : Palette.ok;
                    }
                }
                Text {
                    text: provider;
                    font-size: 12px;
                    font-weight: 600;
                    color: Palette.text;
                    vertical-alignment: center;
                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { provider-clicked(); }
                    }
                }
                if account != "" : Text {
                    text: account;
                    font-size: 12px;
                    color: urgency == Urgency.danger ? Palette.danger
                        : urgency == Urgency.warn ? Palette.warn
                        : account-area.has-hover ? Palette.text : Palette.dim;
                    vertical-alignment: center;
                    account-area := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { account-clicked(); }
                    }
                }
            }
        }
        Divider {}
        Text {
            text: refresh;
            font-size: 12px;
            color: refresh-error ? Palette.warn : Palette.dim;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 0;
            // Long errors elide rather than crowd out the message.
            max-width: 520px;
            if refresh-has-panel : TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { refresh-clicked(); }
            }
        }
        // Player and app messages; key hints when there is nothing to say.
        Text {
            text: message != "" ? message
                : compact-playing != "" ? compact-playing
                : playing ? (guide ? "t list" : titles ? "Tab kind" : "/ search   t guide") + "   space " + (paused ? "resume" : "pause") + (behind ? "   L live" : "") + (movie ? "" : recording != "" ? "   R stop rec" : "   R record") + "   s stop   m mute   - last channel   q quit"
                : episodes ? "j k episode   h l season   Enter play   Esc back   ? keys   q quit"
                : titles ? "Tab kind   f favourite   a order   e categories   r refresh   p provider   ? keys   q quit"
                : (guide ? "t list" : "/ search   t guide") + "   f favourite   r refresh   p provider   ? keys   q quit";
            font-size: 12px;
            color: message-error ? Palette.warn : message != "" ? Palette.text : Palette.dim;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if recording != "" : Text {
            text: recording;
            font-size: 12px;
            font-weight: 600;
            color: Palette.danger;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Rectangle {
            width: 14px;
            horizontal-stretch: 0;
            gear-area := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { settings-clicked(); }
            }
            Image {
                source: @image-url("icons/settings.svg");
                width: 14px;
                height: 14px;
                colorize: gear-area.has-hover ? Palette.text : Palette.dim;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Vidicon";
    default-font-family: "Inter";
    default-font-size: 14px;
    background: Palette.bg;
    preferred-width: 1280px;
    preferred-height: 800px;
    // Fixed, so leaving search mode never finds the window narrower than the
    // three panes need: compositors need not grow a window when its minimum rises.
    min-width: 960px;
    min-height: 600px;

    // The chosen kind's categories: what the library lists below its kind
    // switch. `category` counts the three views above the switch first.
    in property <[CategoryItem]> categories;
    in property <int> category;
    // The library's kind: 0 live, 1 movies, 2 series (VOD ticket 03).
    in property <int> library-kind;
    // What the provider shown offers (M3U ticket 04): without movies and
    // series the kind switches and Continue watching are hidden, without
    // an account the status bar's clicks do not open the dashboard.
    in property <bool> has-vod: true;
    in property <bool> has-account: true;
    // `12 channels`, `1 movie`: the list's count while not filtered.
    in property <string> count-label;
    // The library lists movies or series rather than channels.
    in property <bool> listing-titles;
    in property <string> category-name;
    in property <[ChannelItem]> channels;
    in property <int> channel-count;
    in property <int> selected;
    // The row key of the channel in the detail panel: the LATER list returns
    // to the top when it changes, and only then.
    in property <int> detail-key;
    in property <string> detail-name;
    in property <string> detail-category;
    // The NOW card: a channel's programme airing, or a movie's or series'
    // resume point (VOD ticket 07), headed `RESUME` or `UP NEXT`, with no
    // bar for UP NEXT. `detail-now-hint` is the `S` hint at the heading's
    // right (`START OVER`), as on the NOW PLAYING card, else empty.
    in property <bool> detail-has-now;
    in property <string> detail-now-heading: "NOW";
    in property <string> detail-now-title;
    in property <string> detail-now-times;
    in property <string> detail-now-hint;
    in property <bool> detail-now-bar: true;
    in property <float> detail-progress;
    // A movie or series watched to its end.
    in property <bool> detail-watched;
    in property <[LaterItem]> detail-later;
    in property <string> detail-num;
    in property <bool> detail-favourite;
    // ".ts"; empty for an unavailable favourite.
    in property <string> detail-format;
    in property <string> detail-initials;
    in property <color> detail-tile;
    in property <image> detail-logo;
    // Why there is no guide; empty when there is one, or nothing to say.
    in property <string> detail-no-guide;
    // Which guide source the channel's programmes come from: `from
    // guide.xml.gz`, `from the provider`, empty without a guide.
    in property <string> detail-guide-source;
    // A movie or series is selected: its meta line, plot and facts show
    // in place of the guide (VOD ticket 03).
    in property <bool> detail-title;
    in property <string> detail-meta;
    in property <string> detail-plot;
    in property <[FactItem]> detail-facts;
    // A series (VOD ticket 05): its season pills and the chosen one's
    // episodes in place of the facts. `detail-episodes-note` stands in for
    // the episodes while they load, or when there are none.
    // `episodes-focused`: keys move in the episodes, `detail-episode` is
    // the one selected.
    in property <bool> detail-series;
    in property <[string]> detail-seasons;
    in property <int> detail-season;
    in property <[EpisodeItem]> detail-episodes;
    in property <int> detail-episode;
    in property <string> detail-episodes-note;
    in property <bool> episodes-focused;
    // The selected channel's other listings: `detail-alternates-line` is
    // the header chip saying how many ("+3 listings"), empty with none. `o`
    // or a click on it opens them in LATER's place (`alternates-focused`), the keys on
    // `detail-alternate`.
    in property <string> detail-alternates-line;
    in property <[AlternateItem]> detail-alternates;
    in property <int> detail-alternate;
    in property <bool> alternates-focused;
    in property <[RecentItem]> recent;
    in property <PlayingItem> playing;
    // Status bar: the message (`status`, amber if `status-error`), and the
    // shown provider's account and refresh state.
    in property <string> status;
    in property <bool> status-error;
    in property <bool> refreshing;
    in property <string> empty-hint;
    // Recently played has entries: the list header offers Clear. The first
    // press arms it (amber) and a second clears.
    in property <bool> can-clear;
    in-out property <bool> clear-armed;
    // A–Z instead of provider order (the library header's indicator, `a`).
    in property <bool> order-az;
    // Category allowlist (ticket 20): some categories are hidden, and what
    // the library says when none are shown.
    in property <bool> filtering;
    in property <string> library-hint;
    // Manage mode (`e`): every category with a filter, the rules, and what
    // Ctrl+Enter would do with the filter ("Show only matching",
    // "Remove rule"; empty with no filter).
    in property <bool> managing;
    // Whose categories it lists (VOD ticket 02): 0 live, 1 movies, 2 series.
    in property <int> manage-kind;
    in property <[ManageItem]> manage-rows;
    in property <int> manage-selected;
    in property <string> manage-filter;
    in property <[string]> manage-rules;
    in property <string> manage-summary;
    in property <string> manage-matching;
    in property <string> manage-rule-action;
    // Channel name rules, and what Ctrl+H would do with the filter.
    in property <[NameRuleItem]> manage-name-rules;
    in property <string> manage-name-action;
    // Kept region tags (ticket 26), how many channels they hide (`hides
    // 9800`, empty with none), and what Ctrl+K would do with the filter.
    in property <[string]> manage-kept-tags;
    in property <string> manage-kept-hidden;
    in property <string> manage-kept-action;
    // Sidebar footer: account expiry and connections, and refresh state.
    in property <string> account-status;
    in property <Urgency> account-urgency;
    in property <string> refresh-status;
    in property <bool> refresh-error;
    in property <bool> refresh-has-panel;
    // Search (SPEC 8.2): the filter, and whether typing edits it. While
    // searching, the side panes fold away and the list takes the width.
    in property <string> query;
    in property <bool> searching;
    // The list holds channels and movies or series: title rows say their
    // kind in the number column, so stars, tiles and names line up.
    in property <bool> mixed-kinds;
    // What `/` searches (VOD ticket 09): a kind, a list, or all kinds
    // after Tab; the line under the search bar.
    in property <string> search-scope;
    in property <bool> search-wide;
    in property <string> search-hint;
    // Providers (ticket 10): the one shown, and the `p` picker.
    in property <string> provider-name;
    in property <[ProviderItem]> providers;
    in property <bool> picking;
    in property <int> picker-selected;
    // The account dashboard (ticket 21). The login values are empty while
    // masked.
    // The guide card (EPG sources ticket 05): `E`'s sources, the mapping
    // picker or Settings › EPG's ambiguous list, with a filter typed into
    // when `card-query-shown`, and `card-empty` while no row.
    in property <bool> card-open;
    in property <string> card-title;
    in property <string> card-hint;
    in property <bool> card-query-shown;
    in property <string> card-query;
    in property <string> card-empty;
    in property <[CardRow]> card-rows;
    in property <int> card-selected;
    callback card-clicked(int);
    callback card-activated(int);
    callback card-action(int);
    callback close-card();
    // `?`: the keys panel (ticket 24).
    in property <bool> keys-open;
    in property <[KeyColumn]> key-columns;
    in property <[KeyNote]> key-notes;
    in property <bool> account-open;
    // The refresh panel (SPEC 8.2): open, and its rows. It shows only with
    // rows. Closed from a timer after a success, so in-out.
    in-out property <bool> refresh-panel-open;
    in property <[StageItem]> refresh-stages;
    // The provider's channels were never imported: the refresh's rows
    // show full-window in place of the main screen (refresh panel
    // ticket 02).
    in property <bool> first-run;
    // `v`: the Recordings view (recording ticket 04). `recordings-armed` is
    // the recording a first `x` would cancel, or -1.
    in property <bool> recordings-open;
    in property <[RecordingItem]> recordings;
    in property <int> recordings-selected;
    in-out property <int> recordings-armed: -1;
    // The recording a first `d` would move to the trash, or -1 (ticket 05).
    in-out property <int> recordings-delete-armed: -1;
    // HISTORY has entries: the header offers Clear, which forgets them
    // (files kept). The first press arms it (amber) and a second clears.
    in property <bool> recordings-can-clear;
    in-out property <bool> recordings-clear-armed;
    // Which tab the card shows: 0 Recordings, 1 Downloads (VOD ticket 10).
    in property <int> recordings-tab;
    // A movie's download (VOD ticket 10), as an episode's `download`;
    // `detail-download-warn` when it failed.
    in property <string> detail-download;
    in property <bool> detail-download-warn;
    in property <AccountView> account;
    // `,`: the Settings view (settings ticket 01). The section and field
    // selected, keys on the fields or the sections, and the option a picker
    // open on the field highlights, or -1. `settings-note` says why nothing
    // saves, if the file is managed. `settings-text` is what is typed into
    // the selected field while `settings-editing`; `settings-hint` the keys.
    in property <bool> settings-open;
    in property <bool> settings-editing;
    in property <string> settings-text;
    in property <string> settings-hint;
    in property <[string]> settings-sections;
    in property <int> settings-section;
    in property <bool> settings-in-fields;
    in property <[SettingItem]> settings-fields;
    in property <int> settings-field;
    in property <int> settings-choosing: -1;
    in property <string> settings-note;
    // The setup screen (onboarding ticket 03): the Settings card over
    // everything, its title and text saying why there is no provider,
    // without sections or a way out.
    in property <bool> setup-open;
    in property <string> setup-title;
    in property <string> setup-text;
    in property <string> account-server;
    in property <string> account-username;
    in property <string> account-password;
    // `t`: the guide grid (SPEC 8.2) in place of the three panes. Its
    // channels, the selected one, the half-hour labels across the span, and
    // where now is in it (0 to 1).
    in property <bool> guide-open;
    in property <[GuideItem]> guide-rows;
    in property <int> guide-selected;
    in property <[GuideTick]> guide-ticks;
    // Where the span starts, in timeline widths from the origin: every
    // row's blocks move by it, so time pans without re-reading rows.
    in property <float> guide-offset;
    in property <float> guide-now;
    in property <string> guide-empty-hint;
    // `12 channels with a guide`, for the header.
    in property <string> guide-count;
    // `/` in the grid: typing into its own filter, and the filter.
    in property <bool> guide-searching;
    in property <string> guide-query;
    in property <GuideDetail> guide-detail;
    in property <GuideSel> guide-sel;
    // Rows that fit in the list, for page and half-page moves.
    out property <int> page-rows: managing
        ? max(1, floor(manage-list.visible-height / manage-row-height))
        : guide-open ? max(1, floor(guide-list.visible-height / guide-row-height))
        : max(1, floor(list.visible-height / row-height));

    // Key text and whether Ctrl was held; true if handled.
    callback key(string, bool) -> bool;
    callback select-row(int);
    callback play-row(int);
    // A series' season pill, and an episode clicked or double-clicked.
    callback pick-season(int);
    callback select-episode(int);
    callback play-episode(int);
    callback select-category(int);
    callback select-kind(int);
    callback pick-provider(int);
    callback close-picker();
    callback open-picker();
    callback close-keys();
    callback open-account();
    callback close-account();
    callback open-refresh();
    callback close-refresh();
    callback recordings-select(int);
    callback recordings-select-tab(int);
    callback recordings-play(int);
    callback close-recordings();
    callback open-settings();
    callback close-settings();
    callback settings-select-section(int);
    callback settings-select-field(int);
    // A field's option clicked: a toggle's side, or a picker's entry.
    callback settings-choose(int, int);
    // A stepper's − or + clicked: the field and -1 or 1.
    callback settings-step(int, int);
    // The button under a field: `Create it` makes the missing folder, then
    // saves; `Save anyway` saves the provider despite the check's warning.
    callback settings-button();
    // `Show` or `Hide` on a masked field.
    callback settings-reveal();
    // A field dragged by about this many rows: in Settings › EPG, a guide
    // source moved there (EPG sources ticket 04).
    callback settings-drag(int, int);
    callback clear-recordings();
    // 0 server, 1 username, 2 password.
    callback reveal(int);
    callback play-recent(int);
    callback play-alternate(int);
    callback open-alternates();
    callback clear-history();
    callback toggle-order();
    callback control(PlayerControl);
    callback open-manage();
    callback close-manage();
    callback manage-select(int);
    callback manage-select-kind(int);
    callback manage-toggle(int);
    callback manage-rule();
    callback remove-rule(int);
    callback manage-name-rule();
    callback remove-name-rule(int);
    callback manage-kept-tag();
    callback remove-kept-tag(int);
    // The grid's pointer (ticket 05): a click on row `int` at `float`
    // across the timeline (negative on the channel column), a press, the
    // axis a drag locks to (0 not yet, 1 vertical, 2 horizontal), a
    // horizontal drag since the press and a horizontal wheel, both in
    // timeline widths, and the header's category arrows.
    callback guide-click(int, float);
    callback guide-play(int);
    callback guide-press();
    pure callback guide-drag-axis(length, length) -> int;
    callback guide-pan(float);
    callback guide-scroll(float);
    callback guide-category(int);

    property <length> row-height: searching ? 64px : 52px;
    property <length> episode-row-height: 46px;
    property <length> alternate-row-height: 30px;
    property <length> guide-row-height: 52px;
    // The grid's fixed channel column; the timeline takes the rest of a
    // row, less `guide-gap` on the right.
    property <length> guide-column: 320px;
    property <length> guide-gap: 12px;
    property <length> guide-timeline: guide-list.visible-width - guide-column - guide-gap;
    property <length> category-height: 30px;
    property <length> manage-row-height: 44px;
    // Search and manage mode fold the side panes away.
    property <bool> focus-mode: searching || managing;

    public function show-manage-selected() {
        if (manage-selected * manage-row-height < -manage-list.content-y) {
            manage-list.content-y = -manage-selected * manage-row-height;
        } else if ((manage-selected + 1) * manage-row-height > -manage-list.content-y + manage-list.visible-height) {
            manage-list.content-y = -((manage-selected + 1) * manage-row-height - manage-list.visible-height);
        }
    }

    // Keeps the selected recording, `top` to `bottom` px down the list, in
    // view; Rust knows the heights of the lines above it.
    public function show-recording(top: float, bottom: float) {
        if (top * 1px < -recordings-list.content-y) {
            recordings-list.content-y = -top * 1px;
        } else if (bottom * 1px > -recordings-list.content-y + recordings-list.visible-height) {
            recordings-list.content-y = -(bottom * 1px - recordings-list.visible-height);
        }
    }

    property <length> card-row-height: 48px;

    public function show-card-selected() {
        if (card-selected * card-row-height < -card-list.content-y) {
            card-list.content-y = -card-selected * card-row-height;
        } else if ((card-selected + 1) * card-row-height > -card-list.content-y + card-list.visible-height) {
            card-list.content-y = -((card-selected + 1) * card-row-height - card-list.visible-height);
        }
    }

    public function card-to-top() {
        card-list.content-y = 0;
    }

    // Scrolls the keys panel `across` columns and `rows` keys rows plus
    // `pages` of its height down, within its content.
    public function scroll-keys(across: float, rows: float, pages: float) {
        keys-flick.content-x = clamp(keys-flick.content-x - across * 382px, min(0px, keys-flick.width - keys-flick.content-width), 0px);
        keys-flick.content-y = clamp(keys-flick.content-y - rows * 28px - pages * keys-flick.height, min(0px, keys-flick.height - keys-flick.content-height), 0px);
    }

    public function keys-to-top() {
        keys-flick.content-x = 0;
        keys-flick.content-y = 0;
    }

    public function manage-to-top() {
        manage-list.content-y = 0;
    }

    public function show-guide-selected() {
        scroll-to-guide-selected();
        recheck.running = true;
    }

    function scroll-to-guide-selected() {
        if (guide-selected * guide-row-height < -guide-list.content-y) {
            guide-list.content-y = -guide-selected * guide-row-height;
        } else if ((guide-selected + 1) * guide-row-height > -guide-list.content-y + guide-list.visible-height) {
            guide-list.content-y = -((guide-selected + 1) * guide-row-height - guide-list.visible-height);
        }
    }

    public function guide-to-top() {
        guide-list.content-y = 0;
    }

    // Called by Rust right after it changes the selection or category, so
    // scrolling never races other state changes.


    // Keeps the selection in view, scrolling as little as possible.
    public function show-selected() {
        scroll-to-selected();
        recheck.running = true;
    }

    function scroll-to-selected() {
        if (selected * row-height < -list.content-y) {
            list.content-y = -selected * row-height;
        } else if ((selected + 1) * row-height > -list.content-y + list.visible-height) {
            list.content-y = -((selected + 1) * row-height - list.visible-height);
        }
    }

    // After a long jump (`G`) the ListView briefly underestimates its content
    // height while it builds the new rows, and its bounds check clamps the
    // scroll about 20 px short. One re-check a frame later corrects it.
    recheck := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            if (guide-open) {
                scroll-to-guide-selected();
            } else {
                scroll-to-selected();
            }
        }
    }

    // New category: list back to the top, category kept in view.
    public function show-category() {
        list.content-y = 0;
        // The views above the kind switch are not in `sidebar`.
        if (category < 3) {
            return;
        }
        if ((category - 3) * category-height < -sidebar.content-y) {
            sidebar.content-y = -(category - 3) * category-height;
        } else if ((category - 2) * category-height > -sidebar.content-y + sidebar.visible-height) {
            sidebar.content-y = -((category - 2) * category-height - sidebar.visible-height);
        }
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            // Shift-Tab comes as Tab with Shift held; the handler sees Backtab.
            root.key(e.text == Key.Tab && e.modifiers.shift ? Key.Backtab : e.text, e.modifiers.control) ? accept : reject
        }

        VerticalLayout {
            HorizontalLayout {
                // Under the guide grid while it is open: not drawn.
                visible: !guide-open;
                // Category sidebar
                Rectangle {
                    min-width: focus-mode ? 0px : 180px;
                    preferred-width: focus-mode ? 0px : 200px;
                    max-width: focus-mode ? 0px : 260px;
                    horizontal-stretch: focus-mode ? 0 : 1;
                    visible: !focus-mode;
                    clip: true;
                    background: Palette.surface;
                    VerticalLayout {
                        padding: 16px;
                        padding-right: 8px;
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "Library";
                                font-family: "Inter Display";
                                font-size: 20px;
                                font-weight: 700;
                                color: Palette.text;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            // Manage mode (`e`); accent while categories are hidden.
                            Rectangle {
                                horizontal-stretch: 0;
                                width: 28px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: filtering ? Palette.accent : Palette.line;
                                background: manage-area.pressed ? #ffffff1a : manage-area.has-hover ? #ffffff0f : transparent;
                                manage-area := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { open-manage(); }
                                }
                                Image {
                                    source: @image-url("icons/filter.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: filtering ? Palette.accent : Palette.dim;
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 0;
                                width: order-label.preferred-width + 20px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: order-az ? Palette.accent : Palette.line;
                                background: order-area.pressed ? #ffffff1a : order-area.has-hover ? #ffffff0f : transparent;
                                order-area := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { toggle-order(); }
                                }
                                order-label := Text {
                                    text: order-az ? "A–Z" : "Provider";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: order-az ? Palette.text : Palette.dim;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        // The views across kinds, then the kind switch
                        // (VOD ticket 03): Tab and Shift-Tab, or a click.
                        VerticalLayout {
                            spacing: 0px;
                            for name[i] in ["Favourites", "Recently played", "Continue watching"] : Rectangle {
                                visible: i < 2 || has-vod;
                                height: self.visible ? category-height : 0px;
                                border-radius: 6px;
                                background: i == category ? Palette.surface-2 : transparent;
                                TouchArea {
                                    clicked => { select-category(i); }
                                }
                                Text {
                                    x: 12px;
                                    width: parent.width - 20px;
                                    text: name;
                                    font-size: 13px;
                                    font-weight: i == category ? 600 : 400;
                                    color: i == category ? Palette.text : Palette.dim;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                        if has-vod : Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            background: Palette.bg;
                            HorizontalLayout {
                                padding: 3px;
                                spacing: 2px;
                                for k[i] in ["Live", "Movies", "Series"] : Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 6px;
                                    background: i == library-kind ? Palette.accent-dim
                                        : kind-switch-area.has-hover ? #ffffff0f : transparent;
                                    kind-switch-area := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { select-kind(i); }
                                    }
                                    Text {
                                        text: k;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: i == library-kind ? Palette.accent : Palette.dim;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            sidebar := ListView {
                                mouse-drag-pan-enabled: true;
                                for c[i] in categories : Rectangle {
                                    height: category-height;
                                    border-radius: 6px;
                                    background: i + 3 == category ? Palette.surface-2 : transparent;
                                    TouchArea {
                                        clicked => { select-category(i + 3); }
                                    }
                                    Text {
                                        x: 12px;
                                        width: parent.width - 20px;
                                        text: c.name;
                                        font-size: 13px;
                                        font-weight: i + 3 == category ? 600 : 400;
                                        color: i + 3 == category ? Palette.text : Palette.dim;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                            // Under the kind's All (and Recently added) when
                            // no category is shown.
                            if library-hint != "" : Text {
                                x: 12px;
                                y: (library-kind == 0 ? 1 : 2) * category-height + 12px;
                                width: parent.width - 20px;
                                text: library-hint;
                                font-size: 12px;
                                color: Palette.dim;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // Channel list; a centred focus list while searching.
                Rectangle {
                    min-width: 320px;
                    preferred-width: 400px;
                    horizontal-stretch: 3;
                    VerticalLayout {
                        visible: !managing;
                        width: searching ? min(parent.width, 920px) : parent.width;
                        height: parent.height;
                        x: (parent.width - self.width) / 2;
                        padding: 20px;
                        padding-top: searching ? 28px : 20px;
                        spacing: 14px;
                        if !searching : HorizontalLayout {
                            height: 38px;
                            spacing: 14px;
                            Text {
                                text: category-name;
                                font-family: "Inter Display";
                                font-size: 20px;
                                font-weight: 700;
                                color: Palette.text;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            // The kept filter (Enter in search mode).
                            if query != "" : Rectangle {
                                horizontal-stretch: 0;
                                height: 28px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: Palette.accent;
                                background: Palette.accent-dim;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    Text {
                                        text: "/ " + query + (search-wide ? "  ·  all kinds" : "");
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Palette.text;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Esc clears";
                                        font-size: 11px;
                                        color: Palette.dim;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            if can-clear : Rectangle {
                                horizontal-stretch: 0;
                                width: clear-label.preferred-width + 24px;
                                height: 28px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: clear-armed ? Palette.warn : Palette.line;
                                background: clear-area.pressed ? #ffffff1a : clear-area.has-hover ? #ffffff0f : transparent;
                                clear-area := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { clear-history(); }
                                }
                                clear-label := Text {
                                    text: "Clear";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: clear-armed ? Palette.warn : Palette.dim;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: query != "" ? channel-count + (channel-count == 1 ? " match" : " matches") : count-label;
                                font-size: 13px;
                                color: Palette.dim;
                                vertical-alignment: center;
                            }
                        }
                        if searching : Rectangle {
                            height: 60px;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: Palette.accent;
                            background: Palette.surface-2;
                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                spacing: 14px;
                                Text {
                                    text: "/";
                                    font-size: 18px;
                                    font-weight: 600;
                                    color: Palette.accent;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    horizontal-stretch: 0;
                                    width: scope-label.preferred-width + 20px;
                                    height: 26px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 13px;
                                    background: Palette.accent-dim;
                                    scope-label := Text {
                                        text: search-scope;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Palette.text;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: query != "" ? query + "▏" : "Search " + (search-wide ? "all kinds" : category-name) + "…";
                                    font-size: 20px;
                                    color: query != "" ? Palette.text : Palette.dim;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: channel-count;
                                    font-size: 13px;
                                    color: Palette.dim;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if searching : Text {
                            text: search-hint;
                            font-size: 12px;
                            color: Palette.dim;
                        }
                        Rectangle {
                            list := ListView {
                                mouse-drag-pan-enabled: true;
                                for r[i] in channels : Rectangle {
                                    height: row-height;
                                    border-radius: 8px;
                                    background: i == selected ? Palette.accent-dim : transparent;
                                    // No border while keys move in a series' episodes.
                                    border-width: i == selected && !episodes-focused ? 1px : 0px;
                                    border-color: Palette.accent;
                                    TouchArea {
                                        clicked => { select-row(i); }
                                        double-clicked => { play-row(i); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 12px;
                                        // Movies and series have no number,
                                        // and no column for it unless
                                        // channels share the list: it then
                                        // says their kind.
                                        if !r.poster || mixed-kinds : Text {
                                            width: searching ? 48px : 44px;
                                            text: r.num;
                                            font-size: searching ? 13px : 12px;
                                            color: Palette.dim;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            width: 14px;
                                            text: r.favourite ? "★" : "";
                                            font-size: 13px;
                                            color: r.available ? Palette.star : Palette.dim;
                                            vertical-alignment: center;
                                        }
                                        // Wrapped so it can be centred; a
                                        // layout ignores `y` on its children.
                                        Rectangle {
                                            width: r.poster && !mixed-kinds ? (searching ? 36px : 28px) : (searching ? 40px : 32px);
                                            LogoTile {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                size: r.poster ? (searching ? 54px : 42px) : parent.width;
                                                poster: r.poster;
                                                initials: r.initials;
                                                tile: r.tile;
                                                logo: r.logo;
                                                opacity: r.available ? 1 : 0.4;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            Text {
                                                text: r.name;
                                                font-size: searching ? 17px : 14px;
                                                font-weight: 600;
                                                color: r.available ? Palette.text : Palette.dim;
                                                overflow: elide;
                                            }
                                            HorizontalLayout {
                                                alignment: start;
                                                spacing: 10px;
                                                Text {
                                                    text: r.now;
                                                    font-size: searching ? 13px : 12px;
                                                    color: Palette.dim;
                                                    overflow: elide;
                                                }
                                                if r.has-now : Progress {
                                                    width: 72px;
                                                    y: (parent.height - self.height) / 2;
                                                    value: r.progress;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if channel-count == 0 : Text {
                                text: empty-hint;
                                color: Palette.dim;
                            }
                        }
                    }
                    // Manage mode (ticket 20): every category, a filter, the
                    // rules. Always built, so `manage-list` can be scrolled
                    // from Rust; empty and hidden when not managing.
                    VerticalLayout {
                        visible: managing;
                        width: min(parent.width, 920px);
                        height: parent.height;
                        x: (parent.width - self.width) / 2;
                        padding: 20px;
                        padding-top: 28px;
                        spacing: 14px;
                        HorizontalLayout {
                            height: 38px;
                            spacing: 14px;
                            Text {
                                text: "Categories";
                                font-family: "Inter Display";
                                font-size: 20px;
                                font-weight: 700;
                                color: Palette.text;
                                vertical-alignment: center;
                            }
                            // The kind switch: Tab and Shift-Tab, or a click.
                            HorizontalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                alignment: start;
                                for k[i] in ["Live", "Movies", "Series"] : Rectangle {
                                    visible: has-vod;
                                    width: kind-label.preferred-width + 24px;
                                    height: 28px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 14px;
                                    border-width: 1px;
                                    border-color: i == manage-kind ? Palette.accent : Palette.line;
                                    background: i == manage-kind ? Palette.accent-dim
                                        : kind-area.has-hover ? #ffffff0f : transparent;
                                    kind-area := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { manage-select-kind(i); }
                                    }
                                    kind-label := Text {
                                        text: k;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: i == manage-kind ? Palette.text : Palette.dim;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                            Text {
                                text: manage-summary;
                                font-size: 13px;
                                color: Palette.dim;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 0;
                                width: done-label.preferred-width + 24px;
                                height: 28px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: Palette.line;
                                background: done-area.pressed ? #ffffff1a : done-area.has-hover ? #ffffff0f : transparent;
                                done-area := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { close-manage(); }
                                }
                                done-label := Text {
                                    text: "Done";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Palette.text;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle {
                            height: 52px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Palette.accent;
                            background: Palette.surface-2;
                            HorizontalLayout {
                                padding-left: 18px;
                                padding-right: 18px;
                                spacing: 14px;
                                Text {
                                    text: manage-filter != "" ? manage-filter + "▏" : "Type to filter categories…";
                                    font-size: 17px;
                                    color: manage-filter != "" ? Palette.text : Palette.dim;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: manage-matching;
                                    font-size: 13px;
                                    color: Palette.dim;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        // Chips wrap onto more lines, so the button stays in view.
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: start;
                                Text {
                                    width: 72px;
                                    height: 28px;
                                    text: "Rules";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Palette.dim;
                                    vertical-alignment: center;
                                }
                            }
                            FlexboxLayout {
                                horizontal-stretch: 1;
                                flex-wrap: wrap;
                                spacing: 8px;
                                if manage-rules.length == 0 : Text {
                                    height: 28px;
                                    text: "None: every category shows unless hidden below";
                                    font-size: 12px;
                                    color: Palette.dim;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                for r[i] in manage-rules : Rectangle {
                                    horizontal-stretch: 0;
                                    height: 28px;
                                    width: rule-row.preferred-width;
                                    border-radius: 14px;
                                    background: Palette.accent-dim;
                                    rule-area := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { remove-rule(i); }
                                    }
                                    rule-row := HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        Text {
                                            text: r;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Palette.text;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "×";
                                            font-size: 14px;
                                            color: rule-area.has-hover ? Palette.text : Palette.dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: start;
                                horizontal-stretch: 0;
                                if manage-rule-action != "" : Rectangle {
                                    height: 28px;
                                    width: action-row.preferred-width;
                                    border-radius: 14px;
                                    border-width: 1px;
                                    border-color: Palette.accent;
                                    background: action-area.pressed ? #ffffff1a : action-area.has-hover ? #ffffff0f : transparent;
                                    action-area := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { manage-rule(); }
                                    }
                                    action-row := HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        Text {
                                            text: manage-rule-action;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Palette.text;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Ctrl+Enter";
                                            font-size: 11px;
                                            color: Palette.dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        // Channel name rules (ticket 25): hidden wherever their
                        // category shows. Live only, as are kept tags.
                        // Chips wrap onto more lines, so the button stays in view.
                        if manage-kind == 0 : HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: start;
                                Text {
                                    width: 72px;
                                    height: 28px;
                                    text: "Hide names";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Palette.dim;
                                    vertical-alignment: center;
                                }
                            }
                            FlexboxLayout {
                                horizontal-stretch: 1;
                                flex-wrap: wrap;
                                spacing: 8px;
                                if manage-name-rules.length == 0 : Text {
                                    height: 28px;
                                    text: "None: every channel of a shown category shows";
                                    font-size: 12px;
                                    color: Palette.dim;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                for r[i] in manage-name-rules : Rectangle {
                                    horizontal-stretch: 0;
                                    height: 28px;
                                    width: name-rule-row.preferred-width;
                                    border-radius: 14px;
                                    background: Palette.surface-2;
                                    border-width: 1px;
                                    border-color: Palette.line;
                                    name-rule-area := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { remove-name-rule(i); }
                                    }
                                    name-rule-row := HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        Text {
                                            text: r.pattern;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Palette.text;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: r.hidden;
                                            font-size: 12px;
                                            color: Palette.dim;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "×";
                                            font-size: 14px;
                                            color: name-rule-area.has-hover ? Palette.text : Palette.dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: start;
                                horizontal-stretch: 0;
                                if manage-name-action != "" : Rectangle {
                                    height: 28px;
                                    width: name-action-row.preferred-width;
                                    border-radius: 14px;
                                    border-width: 1px;
                                    border-color: Palette.line;
                                    background: name-action-area.pressed ? #ffffff1a : name-action-area.has-hover ? #ffffff0f : transparent;
                                    name-action-area := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { manage-name-rule(); }
                                    }
                                    name-action-row := HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        Text {
                                            text: manage-name-action;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Palette.text;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Ctrl+H";
                                            font-size: 11px;
                                            color: Palette.dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        // Kept region tags (ticket 26): tagged channels of other
                        // regions are hidden; untagged ones always show.
                        // Chips wrap onto more lines, so the button stays in view.
                        if manage-kind == 0 : HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: start;
                                Text {
                                    width: 72px;
                                    height: 28px;
                                    text: "Keep tags";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Palette.dim;
                                    vertical-alignment: center;
                                }
                            }
                            FlexboxLayout {
                                horizontal-stretch: 1;
                                flex-wrap: wrap;
                                spacing: 8px;
                                if manage-kept-tags.length == 0 : Text {
                                    height: 28px;
                                    text: "None: channels of every region show";
                                    font-size: 12px;
                                    color: Palette.dim;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                for t[i] in manage-kept-tags : Rectangle {
                                    horizontal-stretch: 0;
                                    height: 28px;
                                    width: kept-row.preferred-width;
                                    border-radius: 14px;
                                    background: Palette.surface-2;
                                    border-width: 1px;
                                    border-color: Palette.line;
                                    kept-area := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { remove-kept-tag(i); }
                                    }
                                    kept-row := HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        Text {
                                            text: t;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Palette.text;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "×";
                                            font-size: 14px;
                                            color: kept-area.has-hover ? Palette.text : Palette.dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                if manage-kept-hidden != "" : Text {
                                    height: 28px;
                                    text: manage-kept-hidden;
                                    font-size: 12px;
                                    color: Palette.dim;
                                    vertical-alignment: center;
                                }
                            }
                            VerticalLayout {
                                alignment: start;
                                horizontal-stretch: 0;
                                if manage-kept-action != "" : Rectangle {
                                    height: 28px;
                                    width: kept-action-row.preferred-width;
                                    border-radius: 14px;
                                    border-width: 1px;
                                    border-color: Palette.line;
                                    background: kept-action-area.pressed ? #ffffff1a : kept-action-area.has-hover ? #ffffff0f : transparent;
                                    kept-action-area := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { manage-kept-tag(); }
                                    }
                                    kept-action-row := HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        Text {
                                            text: manage-kept-action;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Palette.text;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Ctrl+K";
                                            font-size: 11px;
                                            color: Palette.dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            manage-list := ListView {
                                mouse-drag-pan-enabled: true;
                                for m[i] in manage-rows : Rectangle {
                                    height: manage-row-height;
                                    border-radius: 8px;
                                    background: i == manage-selected ? Palette.accent-dim : transparent;
                                    border-width: i == manage-selected ? 1px : 0px;
                                    border-color: Palette.accent;
                                    TouchArea {
                                        clicked => { manage-select(i); }
                                        double-clicked => { manage-toggle(i); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 16px;
                                        spacing: 14px;
                                        // Shown or hidden; a click toggles it.
                                        Rectangle {
                                            width: 84px;
                                            height: 26px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 13px;
                                            border-width: 1px;
                                            border-color: m.shown ? Palette.accent : Palette.line;
                                            background: pill-area.has-hover ? #ffffff0f : transparent;
                                            pill-area := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { manage-toggle(i); }
                                            }
                                            Text {
                                                text: m.shown ? "● Shown" : "○ Hidden";
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: m.shown ? Palette.accent : Palette.dim;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: m.name;
                                            font-size: 14px;
                                            font-weight: m.shown ? 600 : 400;
                                            color: m.shown ? Palette.text : Palette.dim;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        if m.overridden : Text {
                                            text: "override";
                                            font-size: 11px;
                                            color: Palette.warn;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            width: 72px;
                                            text: m.channels;
                                            font-size: 12px;
                                            color: Palette.dim;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            if managing && manage-rows.length == 0 : Text {
                                text: manage-filter != "" ? "No categories match." : "No categories yet.";
                                color: Palette.dim;
                            }
                        }
                        Text {
                            text: "↑↓ move  ·  " + (has-vod ? "Tab kind  ·  " : "")
                                + "Enter shows or hides  ·  Ctrl+Enter adds the filter as a rule  ·  "
                                + (manage-kind == 0 ? "Ctrl+H hides names with it  ·  Ctrl+K keeps it as a tag  ·  " : "")
                                + "Esc done";
                            font-size: 12px;
                            color: Palette.dim;
                            overflow: elide;
                        }
                    }
                }

                // Detail panel (SPEC 8.2)
                detail-pane := Rectangle {
                    min-width: focus-mode ? 0px : 260px;
                    preferred-width: focus-mode ? 0px : 320px;
                    max-width: focus-mode ? 0px : 340px;
                    horizontal-stretch: focus-mode ? 0 : 1;
                    visible: !focus-mode;
                    clip: true;
                    background: Palette.surface;
                    // Not built in search or manage mode: squeezed to 0 px, its wrapped
                    // text would wrap per character and push the status bar
                    // off the window.
                    if !focus-mode && !guide-open : VerticalLayout {
                        padding: 20px;
                        spacing: 10px;
                        if detail-name != "" : HorizontalLayout {
                            spacing: 14px;
                            alignment: start;
                            LogoTile {
                                size: detail-title ? 120px : 88px;
                                poster: detail-title;
                                initials: detail-initials;
                                tile: detail-tile;
                                logo: detail-logo;
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: detail-num != "" && detail-category != ""
                                        ? detail-num + "  ·  " + detail-category
                                        : detail-num + detail-category;
                                    font-size: 12px;
                                    color: Palette.dim;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    if detail-favourite : Chip {
                                        text: "★ Favourite";
                                        ink: Palette.star;
                                        fill: #f2c14e22;
                                    }
                                    if detail-format != "" : Chip {
                                        text: detail-format;
                                    }
                                    if !detail-title && detail-alternates-line != "" : Chip {
                                        text: detail-alternates-line;
                                        ink: alternates-focused || alternates-chip-area.has-hover ? Palette.accent : Palette.dim;
                                        alternates-chip-area := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { open-alternates(); }
                                        }
                                    }
                                    if detail-watched : Chip {
                                        text: "✓ Watched";
                                    }
                                    if detail-download != "" : Chip {
                                        text: detail-download;
                                        ink: detail-download-warn ? Palette.warn : Palette.dim;
                                    }
                                }
                            }
                        }
                        Text {
                            text: detail-name;
                            font-family: "Inter Display";
                            font-size: 24px;
                            font-weight: 700;
                            color: Palette.text;
                            wrap: word-wrap;
                        }
                        if detail-has-now : Rectangle {
                            vertical-stretch: 0;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Palette.line;
                            background: Palette.surface-2;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;
                                HorizontalLayout {
                                    Text {
                                        text: detail-now-heading;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Palette.accent;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: detail-now-hint;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Palette.accent;
                                    }
                                }
                                Text {
                                    text: detail-now-title;
                                    font-size: 17px;
                                    font-weight: 600;
                                    color: Palette.text;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: detail-now-times;
                                    font-size: 12px;
                                    color: Palette.dim;
                                }
                                if detail-now-bar : Progress {
                                    value: detail-progress;
                                }
                            }
                        }
                        if detail-no-guide != "" : Rectangle {
                            vertical-stretch: 0;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Palette.line;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 4px;
                                Text {
                                    text: "No guide for this channel";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Palette.dim;
                                }
                                Text {
                                    text: detail-no-guide;
                                    font-size: 12px;
                                    color: Palette.dim;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        // A movie's or series' meta line, plot and facts,
                        // taking the space left and scrolling what doesn't
                        // fit, back at the top for each title.
                        if detail-title && !detail-series : Flickable {
                            vertical-stretch: 1;
                            content-height: title-info.preferred-height;
                            property <int> of: detail-key;
                            changed of => { self.content-y = 0; }
                            title-info := VerticalLayout {
                                width: parent.width;
                                alignment: start;
                                spacing: 10px;
                                if detail-meta != "" : Text {
                                    text: detail-meta;
                                    font-size: 13px;
                                    color: Palette.dim;
                                }
                                if detail-plot != "" : Text {
                                    text: detail-plot;
                                    font-size: 13px;
                                    color: Palette.text;
                                    wrap: word-wrap;
                                }
                                for f in detail-facts : VerticalLayout {
                                    spacing: 2px;
                                    Heading {
                                        text: f.label;
                                    }
                                    Text {
                                        text: f.value;
                                        font-size: 13px;
                                        color: Palette.text;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                        // A series (VOD ticket 05): meta line and plot, then
                        // the season pills, and the season's episodes taking
                        // the space left.
                        if detail-series : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 10px;
                            if detail-meta != "" : Text {
                                text: detail-meta;
                                font-size: 13px;
                                color: Palette.dim;
                                wrap: word-wrap;
                            }
                            if detail-plot != "" : Text {
                                text: detail-plot;
                                font-size: 13px;
                                color: Palette.text;
                                wrap: word-wrap;
                                overflow: elide;
                                // Four lines; the episodes need the room.
                                max-height: 72px;
                            }
                            season-strip := Flickable {
                                height: detail-seasons.length > 0 ? 30px : 0px;
                                content-width: pills.preferred-width;
                                // A new series' pills start at the left.
                                property <int> of: detail-key;
                                changed of => { self.content-x = 0; }
                                pills := HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    for name[i] in detail-seasons : Rectangle {
                                        width: season-label.preferred-width + 24px;
                                        // The chosen season's pill is kept in view.
                                        property <bool> chosen: i == detail-season;
                                        changed chosen => {
                                            if (!self.chosen) {
                                                return;
                                            }
                                            if (self.x < -season-strip.content-x) {
                                                season-strip.content-x = -self.x;
                                            } else if (self.x + self.width > -season-strip.content-x + season-strip.width) {
                                                season-strip.content-x = -(self.x + self.width - season-strip.width);
                                            }
                                        }
                                        height: 30px;
                                        border-radius: 7px;
                                        border-width: i == detail-season ? 0px : 1px;
                                        border-color: Palette.line;
                                        background: i == detail-season ? Palette.accent-dim
                                            : season-area.has-hover ? Palette.surface-2 : transparent;
                                        season-area := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { pick-season(i); }
                                        }
                                        season-label := Text {
                                            text: name;
                                            font-size: 13px;
                                            font-weight: 500;
                                            color: i == detail-season ? Palette.accent : #c9cedb;
                                        }
                                    }
                                }
                            }
                            if detail-episodes-note != "" : Text {
                                text: detail-episodes-note;
                                font-size: 13px;
                                color: Palette.dim;
                                wrap: word-wrap;
                            }
                            ListView {
                                min-height: 0;
                                vertical-stretch: 1;
                                mouse-drag-pan-enabled: true;
                                // A new series starts at the top; the selected
                                // episode is kept in view, scrolling as little
                                // as possible (a new season selects the first).
                                property <int> of: detail-key;
                                changed of => { self.content-y = 0; }
                                property <int> season: detail-season;
                                changed season => { self.content-y = 0; }
                                property <int> sel: detail-episode;
                                changed sel => {
                                    if (self.sel * episode-row-height < -self.content-y) {
                                        self.content-y = -self.sel * episode-row-height;
                                    } else if ((self.sel + 1) * episode-row-height > -self.content-y + self.visible-height) {
                                        self.content-y = -((self.sel + 1) * episode-row-height - self.visible-height);
                                    }
                                }
                                for e[i] in detail-episodes : Rectangle {
                                    height: episode-row-height;
                                    border-radius: 8px;
                                    border-width: episodes-focused && i == detail-episode ? 1px : 0px;
                                    border-color: Palette.accent;
                                    background: episodes-focused && i == detail-episode ? Palette.accent-dim
                                        : episode-area.has-hover ? Palette.surface-2 : transparent;
                                    episode-area := TouchArea {
                                        clicked => { select-episode(i); }
                                        double-clicked => { play-episode(i); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 10px;
                                        Text {
                                            text: e.num;
                                            width: 24px;
                                            font-size: 13px;
                                            color: Palette.dim;
                                            vertical-alignment: center;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: e.title;
                                                font-size: 14px;
                                                font-weight: 500;
                                                color: Palette.text;
                                                overflow: elide;
                                            }
                                            HorizontalLayout {
                                                alignment: start;
                                                spacing: 10px;
                                                if e.length != "" || e.watched : Text {
                                                    text: e.watched && e.length != "" ? e.length + "  ·  ✓ Watched"
                                                        : e.watched ? "✓ Watched" : e.length;
                                                    font-size: 12px;
                                                    color: Palette.dim;
                                                }
                                                if e.download != "" : Text {
                                                    text: e.download;
                                                    font-size: 12px;
                                                    color: e.download == "↓ Failed" ? Palette.warn : Palette.dim;
                                                }
                                                if e.has-progress : Progress {
                                                    width: 72px;
                                                    y: (parent.height - self.height) / 2;
                                                    value: e.progress;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // Other listings of the channel, opened in LATER's place.
                        if !detail-title && alternates-focused : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 4px;
                            HorizontalLayout {
                                Heading {
                                    text: "OTHER LISTINGS";
                                    horizontal-stretch: 1;
                                }
                                Heading {
                                    text: "Enter plays · Esc back";
                                    font-weight: 400;
                                    horizontal-alignment: right;
                                }
                            }
                            ListView {
                                min-height: 0;
                                vertical-stretch: 1;
                                mouse-drag-pan-enabled: true;
                                // The selected listing is kept in view.
                                property <int> sel: detail-alternate;
                                changed sel => {
                                    if (self.sel * alternate-row-height < -self.content-y) {
                                        self.content-y = -self.sel * alternate-row-height;
                                    } else if ((self.sel + 1) * alternate-row-height > -self.content-y + self.visible-height) {
                                        self.content-y = -((self.sel + 1) * alternate-row-height - self.visible-height);
                                    }
                                }
                                for a[i] in detail-alternates : Rectangle {
                                    height: alternate-row-height;
                                    border-radius: 6px;
                                    border-width: i == detail-alternate ? 1px : 0px;
                                    border-color: Palette.accent;
                                    background: i == detail-alternate ? Palette.accent-dim
                                        : alternate-area.has-hover ? Palette.surface-2 : transparent;
                                    alternate-area := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { play-alternate(i); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 10px;
                                        Text {
                                            text: a.num;
                                            width: 40px;
                                            font-size: 12px;
                                            color: Palette.dim;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: a.name;
                                            font-size: 13px;
                                            color: Palette.text;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: a.category;
                                            max-width: 120px;
                                            font-size: 12px;
                                            color: Palette.dim;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        // LATER takes the space left and scrolls what doesn't
                        // fit, back at the top for each channel.
                        if !detail-title && !alternates-focused : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 4px;
                            if detail-later.length > 0 || detail-guide-source != "" : HorizontalLayout {
                                Heading {
                                    text: detail-later.length > 0 ? "LATER" : "";
                                    horizontal-stretch: 1;
                                }
                                Heading {
                                    text: detail-guide-source;
                                    font-weight: 400;
                                    overflow: elide;
                                    horizontal-alignment: right;
                                }
                            }
                            ListView {
                                // Scrolls only; the empty state keeps no room.
                                min-height: 0;
                                mouse-drag-pan-enabled: true;
                                vertical-stretch: 1;
                                // A new channel's list starts at the top.
                                property <int> of: detail-key;
                                changed of => { self.content-y = 0; }
                                for l in detail-later : HorizontalLayout {
                                    height: 24px;
                                    spacing: 8px;
                                    Text {
                                        text: l.time;
                                        width: 44px;
                                        font-size: 13px;
                                        color: Palette.dim;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: l.title;
                                        font-size: 13px;
                                        color: Palette.text;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                        // Channels only, so not beside a movie's or series' details (VOD
                        // ticket 03; 11 brings other kinds into Recently played).
                        if !detail-title : VerticalLayout {
                            spacing: 10px;
                            if recent.length > 0 : Heading {
                                text: "RECENTLY PLAYED";
                            }
                            for r[i] in recent : Rectangle {
                                height: 36px;
                                border-radius: 6px;
                                background: recent-area.has-hover ? Palette.surface-2 : transparent;
                                recent-area := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { play-recent(i); }
                                }
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    spacing: 10px;
                                    Text {
                                        text: r.num;
                                        width: 40px;
                                        font-size: 12px;
                                        color: Palette.dim;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        width: 28px;
                                        LogoTile {
                                            y: (parent.height - self.height) / 2;
                                            size: 28px;
                                            initials: r.initials;
                                            tile: r.tile;
                                            logo: r.logo;
                                        }
                                    }
                                    Text {
                                        text: r.name;
                                        font-size: 13px;
                                        color: Palette.text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                        if playing.visible : Rectangle {
                            vertical-stretch: 0;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Palette.line;
                            background: Palette.surface-2;
                            VerticalLayout {
                                padding: 14px;
                                padding-bottom: 8px;
                                spacing: 10px;
                                HorizontalLayout {
                                    Text {
                                        text: playing.heading;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: playing.paused || playing.behind ? Palette.warn : Palette.ok;
                                        horizontal-stretch: 1;
                                    }
                                    if playing.recording != "" : Text {
                                        text: playing.recording;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Palette.danger;
                                    }
                                    if playing.recording == "" : Text {
                                        text: playing.start-over;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Palette.accent;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    LogoTile {
                                        size: 44px;
                                        poster: playing.movie;
                                        initials: playing.initials;
                                        tile: playing.tile;
                                        logo: playing.logo;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        Text {
                                            text: playing.name;
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: Palette.text;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: playing.title;
                                            font-size: 12px;
                                            color: Palette.dim;
                                            overflow: elide;
                                        }
                                    }
                                }
                                // Times left, time left right, bar under.
                                VerticalLayout {
                                    spacing: 6px;
                                    HorizontalLayout {
                                        Text {
                                            text: playing.span;
                                            font-size: 11px;
                                            color: Palette.dim;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: playing.left;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: Palette.text;
                                        }
                                    }
                                    if playing.has-guide : Progress {
                                        value: playing.progress;
                                    }
                                }
                                Rectangle {
                                    height: 1px;
                                    background: Palette.line;
                                }
                                HorizontalLayout {
                                    alignment: space-around;
                                    IconButton {
                                        icon: playing.paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                                        on: playing.paused;
                                        clicked => { control(PlayerControl.pause); }
                                    }
                                    // Live only, so not for a movie.
                                    if !playing.movie : IconButton {
                                        icon: @image-url("icons/live.svg");
                                        dimmed: !playing.behind;
                                        clicked => { control(PlayerControl.live); }
                                    }
                                    if !playing.movie : IconButton {
                                        icon: @image-url("icons/record.svg");
                                        on: playing.recording != "";
                                        on-ink: Palette.danger;
                                        on-fill: Palette.danger-dim;
                                        clicked => { control(PlayerControl.record); }
                                    }
                                    IconButton {
                                        icon: @image-url("icons/stop.svg");
                                        clicked => { control(PlayerControl.stop); }
                                    }
                                    IconButton {
                                        icon: playing.muted ? @image-url("icons/muted.svg") : @image-url("icons/volume.svg");
                                        on: playing.muted;
                                        clicked => { control(PlayerControl.mute); }
                                    }
                                    IconButton {
                                        icon: playing.fullscreen ? @image-url("icons/fullscreen-exit.svg") : @image-url("icons/fullscreen.svg");
                                        on: playing.fullscreen;
                                        clicked => { control(PlayerControl.fullscreen); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            status-bar := StatusBar {
                provider: provider-name;
                account: account-status;
                has-account: has-account;
                urgency: account-urgency;
                refresh: refresh-status;
                refresh-error: refresh-error;
                refresh-has-panel: refresh-has-panel;
                refreshing: refreshing;
                message: status;
                message-error: status-error;
                playing: playing.visible;
                paused: playing.paused;
                behind: playing.behind;
                guide: guide-open;
                titles: listing-titles;
                recording: playing.recording;
                movie: playing.movie;
                episodes: episodes-focused;
                compact-playing: (focus-mode || guide-open) && playing.visible
                    ? (playing.paused ? "❚❚ " : "▶ ") + playing.name + (playing.catch-up ? " · catch-up" : "") + (playing.muted ? " · muted" : "")
                    : "";
                provider-clicked => { open-picker(); }
                account-clicked => { open-account(); }
                refresh-clicked => { open-refresh(); }
                settings-clicked => { open-settings(); }
            }
        }

        // `t`: the guide grid (SPEC 8.2), over the three panes, which are not
        // drawn while it is open. Always built, so `guide-list` can be
        // scrolled from Rust; empty when closed.
        Rectangle {
            visible: guide-open;
            x: 0;
            y: 0;
            width: parent.width;
            height: status-bar.y;
            background: Palette.bg;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                HorizontalLayout {
                    height: 38px;
                    spacing: 14px;
                    Text {
                        text: "Guide";
                        font-family: "Inter Display";
                        font-size: 20px;
                        font-weight: 700;
                        color: Palette.text;
                        vertical-alignment: center;
                    }
                    // The category, with arrows to the previous and next.
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text {
                            width: 20px;
                            text: "‹";
                            font-size: 18px;
                            color: Palette.dim;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            TouchArea {
                                clicked => { guide-category(-1); }
                            }
                        }
                        Text {
                            text: category-name;
                            font-size: 13px;
                            color: Palette.dim;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            width: 20px;
                            text: "›";
                            font-size: 18px;
                            color: Palette.dim;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            TouchArea {
                                clicked => { guide-category(1); }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    if guide-searching : Text {
                        text: "Enter keeps the filter  ·  Esc clears it";
                        font-size: 12px;
                        color: Palette.dim;
                        vertical-alignment: center;
                    }
                    // The filter: accent while typing, kept after Enter.
                    if guide-searching || guide-query != "" : Rectangle {
                        width: 320px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: guide-searching ? Palette.accent : Palette.line;
                        background: guide-searching ? Palette.surface-2 : Palette.surface;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            Text {
                                text: "/";
                                font-size: 13px;
                                font-weight: 600;
                                color: Palette.accent;
                                vertical-alignment: center;
                            }
                            Text {
                                text: guide-query != "" ? guide-query + (guide-searching ? "▏" : "") : "Search " + category-name + "…";
                                font-size: 13px;
                                color: guide-query != "" ? Palette.text : Palette.dim;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    Text {
                        text: guide-count;
                        font-size: 13px;
                        color: Palette.dim;
                        vertical-alignment: center;
                    }
                }
                // The selected programme.
                if guide-rows.length > 0 : Rectangle {
                    height: 132px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Palette.line;
                    background: Palette.surface;
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 3px;
                        Text {
                            text: guide-detail.channel;
                            font-size: 12px;
                            font-weight: 600;
                            color: Palette.dim;
                            overflow: elide;
                        }
                        Text {
                            text: guide-detail.title;
                            font-family: "Inter Display";
                            font-size: 17px;
                            font-weight: 700;
                            color: guide-detail.times == "" ? Palette.dim : Palette.text;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: guide-detail.times;
                                font-size: 12px;
                                color: guide-detail.airing ? Palette.accent : Palette.dim;
                                overflow: elide;
                                horizontal-stretch: 0;
                            }
                            Text {
                                text: guide-detail.replay;
                                font-size: 12px;
                                font-weight: 600;
                                color: Palette.accent;
                                overflow: elide;
                                horizontal-stretch: 0;
                            }
                            Text {
                                text: guide-detail.record;
                                font-size: 12px;
                                font-weight: 600;
                                color: Palette.danger;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                        // Up to three lines.
                        Text {
                            height: 48px;
                            text: guide-detail.description;
                            font-size: 12px;
                            color: Palette.text;
                            wrap: word-wrap;
                            overflow: elide;
                            vertical-alignment: top;
                        }
                    }
                }
                Rectangle {
                    // Half-hour lines, behind the rows.
                    for t in guide-ticks : Rectangle {
                        visible: guide-rows.length > 0;
                        x: guide-column + guide-timeline * t.x;
                        y: 0;
                        width: 1px;
                        height: parent.height;
                        background: Palette.line;
                    }
                    VerticalLayout {
                        // The time header: fixed while the rows scroll.
                        Rectangle {
                            height: 26px;
                            for t in guide-ticks : Text {
                                x: guide-column + guide-timeline * t.x + 6px;
                                height: parent.height;
                                text: t.label;
                                font-size: 12px;
                                color: Palette.dim;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            // The pointer is `guide-pointer`'s, over it.
                            guide-list := ListView {
                                for r[i] in guide-rows : Rectangle {
                                    height: guide-row-height;
                                    border-radius: 8px;
                                    background: i == guide-selected ? Palette.accent-dim : transparent;
                                    HorizontalLayout {
                                        x: 0;
                                        width: guide-column;
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        Text {
                                            width: 44px;
                                            text: r.num;
                                            font-size: 12px;
                                            color: Palette.dim;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            width: 12px;
                                            text: r.favourite ? "★" : "";
                                            font-size: 13px;
                                            color: Palette.star;
                                            vertical-alignment: center;
                                        }
                                        // Wrapped so it can be centred.
                                        Rectangle {
                                            width: 32px;
                                            LogoTile {
                                                y: (parent.height - self.height) / 2;
                                                size: parent.width;
                                                initials: r.initials;
                                                tile: r.tile;
                                                logo: r.logo;
                                            }
                                        }
                                        Text {
                                            text: r.name;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Palette.text;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    // The page's blocks, placed by the offset
                                    // and cut to the timeline.
                                    Rectangle {
                                        x: guide-column;
                                        width: guide-timeline;
                                        clip: true;
                                        for b in r.blocks : Rectangle {
                                            property <bool> selected: i == guide-sel.row && !guide-sel.gap && b.start == guide-sel.start;
                                            x: guide-timeline * (b.x - guide-offset);
                                            width: max(0px, guide-timeline * b.w - 3px);
                                            y: 4px;
                                            height: parent.height - 8px;
                                            border-radius: 6px;
                                            border-width: self.selected ? 2px : 1px;
                                            border-color: self.selected ? Palette.accent : Palette.line;
                                            background: b.airing ? Palette.accent-dim : self.selected ? Palette.surface-2 : Palette.surface;
                                            clip: false;
                                            // Placed by hand rather than in a layout: only
                                            // `x` follows the offset, so moving through
                                            // time re-lays no text. A block that began
                                            // before the span keeps its text in view.
                                            Text {
                                                x: max(8px, 8px - parent.x);
                                                y: parent.height / 2 - 15px;
                                                width: max(0px, parent.width - (b.rec == RecMark.none && !b.archive ? 8px : 22px) - self.x);
                                                text: b.title;
                                                font-size: 12px;
                                                font-weight: b.airing ? 600 : 400;
                                                color: b.gone ? Palette.dim : Palette.text;
                                                overflow: elide;
                                            }
                                            Text {
                                                x: max(8px, 8px - parent.x);
                                                y: parent.height / 2 + 1px;
                                                width: max(0px, parent.width - 8px - self.x);
                                                text: b.times;
                                                font-size: 11px;
                                                color: Palette.dim;
                                                overflow: elide;
                                            }
                                            // The record mark: a ring while
                                            // scheduled, filled while recording.
                                            if b.rec != RecMark.none : Rectangle {
                                                x: parent.width - 16px;
                                                y: parent.height / 2 - 11px;
                                                width: 8px;
                                                height: 8px;
                                                border-radius: 4px;
                                                border-width: 1.5px;
                                                border-color: Palette.danger;
                                                background: b.rec == RecMark.recording ? Palette.danger : transparent;
                                            }
                                            // The archive mark: a past
                                            // programme catch-up can play.
                                            if b.archive && b.rec == RecMark.none : Image {
                                                x: parent.width - 18px;
                                                y: parent.height / 2 - 13px;
                                                width: 11px;
                                                height: 11px;
                                                source: @image-url("icons/archive.svg");
                                                colorize: Palette.accent;
                                            }
                                        }
                                        // A selected gap in the guide.
                                        if i == guide-sel.row && guide-sel.gap : Rectangle {
                                            x: guide-timeline * (guide-sel.x - guide-offset);
                                            width: max(0px, guide-timeline * guide-sel.w - 3px);
                                            y: 4px;
                                            height: parent.height - 8px;
                                            border-radius: 6px;
                                            border-width: 2px;
                                            border-color: Palette.accent;
                                            background: Palette.surface-2;
                                            clip: true;
                                            Text {
                                                x: max(8px, 8px - parent.x);
                                                width: parent.width - 16px;
                                                text: "No information";
                                                font-size: 12px;
                                                font-italic: true;
                                                color: Palette.dim;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                            // Clicks, wheel and drags over the rows, short of
                            // the scrollbar. A drag locks to the direction it
                            // starts in: vertical pans the channels, horizontal
                            // the time.
                            guide-pointer := TouchArea {
                                width: guide-column + guide-timeline;
                                // 0 not locked yet, 1 vertical, 2 horizontal.
                                property <int> axis;
                                property <length> press-y;
                                property <length> lowest: min(0px, guide-list.visible-height - guide-rows.length * guide-row-height);
                                function row-at(y: length) -> int {
                                    return floor((y - guide-list.content-y) / guide-row-height);
                                }
                                function x-at(x: length) -> float {
                                    return (x - guide-column) / guide-timeline;
                                }
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                        self.axis = 0;
                                        self.press-y = guide-list.content-y;
                                        guide-press();
                                    }
                                }
                                moved => {
                                    if (!self.pressed) {
                                        return;
                                    }
                                    if (self.axis == 0) {
                                        self.axis = guide-drag-axis(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                                    }
                                    if (self.axis == 1) {
                                        guide-list.content-y = clamp(self.press-y + self.mouse-y - self.pressed-y, self.lowest, 0px);
                                    } else if (self.axis == 2) {
                                        guide-pan((self.mouse-x - self.pressed-x) / guide-timeline);
                                    }
                                }
                                clicked => {
                                    if (self.axis == 0 && self.row-at(self.mouse-y) < guide-rows.length) {
                                        guide-click(self.row-at(self.mouse-y), self.x-at(self.mouse-x));
                                    }
                                }
                                double-clicked => {
                                    if (self.axis == 0 && self.row-at(self.mouse-y) < guide-rows.length) {
                                        guide-play(self.row-at(self.mouse-y));
                                    }
                                }
                                // Shift+wheel and a horizontal swipe move the
                                // time; the plain wheel scrolls the channels.
                                scroll-event(e) => {
                                    if (e.modifiers.shift || abs(e.delta-x) > abs(e.delta-y)) {
                                        guide-scroll((e.delta-x != 0 ? e.delta-x : e.delta-y) / guide-timeline);
                                    } else {
                                        guide-list.content-y = clamp(guide-list.content-y + e.delta-y, self.lowest, 0px);
                                    }
                                    accept
                                }
                            }
                            if guide-open && guide-rows.length == 0 : Text {
                                text: guide-empty-hint;
                                color: Palette.dim;
                            }
                        }
                    }
                    // Now, across the header and the rows.
                    if guide-rows.length > 0 && guide-now >= 0 && guide-now <= 1 : Rectangle {
                        x: guide-column + guide-timeline * guide-now - 1px;
                        y: 0;
                        width: 2px;
                        height: parent.height;
                        background: Palette.accent;
                    }
                }
            }
        }
        // First run: the refresh panel's rows, full-window and in large
        // type, until the channels land (SPEC 7.2).
        if first-run : Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: status-bar.y;
            background: Palette.bg;
            TouchArea {}
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: 460px;
                        spacing: 14px;
                        Image {
                            source: @image-url("../assets/vidicon.svg");
                            height: 112px;
                            image-fit: contain;
                        }
                        Text {
                            text: "Loading " + provider-name;
                            font-family: "Inter Display";
                            font-size: 28px;
                            font-weight: 700;
                            color: Palette.text;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: "The first refresh. The channels show as soon as they land.";
                            font-size: 14px;
                            color: Palette.dim;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Rectangle { height: 6px; }
                        Rectangle {
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: Palette.line;
                            background: Palette.surface;
                            VerticalLayout {
                                padding: 24px;
                                padding-top: 18px;
                                padding-bottom: 18px;
                                spacing: 6px;
                                // Before the stages: the account check.
                                if refresh-stages.length == 0 : Text {
                                    text: refresh-status;
                                    font-size: 20px;
                                    color: refresh-error ? Palette.warn : Palette.dim;
                                    wrap: word-wrap;
                                }
                                for stage in refresh-stages : VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        height: 36px;
                                        spacing: 16px;
                                        padding-left: stage.source ? 16px : 0px;
                                        Text {
                                            width: stage.source ? 200px : 130px;
                                            text: stage.name;
                                            font-size: stage.source ? 17px : 20px;
                                            color: stage.source ? Palette.dim : Palette.text;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: stage.state;
                                            font-size: 20px;
                                            color: stage.tone == StageTone.running ? Palette.accent
                                                : stage.tone == StageTone.done ? Palette.ok
                                                : stage.tone == StageTone.warn ? Palette.warn
                                                : Palette.dim;
                                            vertical-alignment: center;
                                            horizontal-alignment: right;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    if stage.reason != "" : HorizontalLayout {
                                        padding-left: 146px;
                                        Text {
                                            // Fixed, so the card's height
                                            // counts the wrapped lines: 460
                                            // less padding and names.
                                            width: 266px;
                                            text: stage.reason;
                                            horizontal-alignment: right;
                                            font-size: 15px;
                                            color: Palette.warn;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                        if refresh-error && !refreshing : Text {
                            text: "Press r to retry.";
                            font-size: 15px;
                            color: Palette.dim;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
        // `p`: the provider picker, over everything.
        if picking : Rectangle {
            background: #0009;
            TouchArea {
                clicked => { close-picker(); }
            }
            Rectangle {
                width: 420px;
                height: picker-list.preferred-height + 32px;
                border-radius: 14px;
                border-width: 1px;
                border-color: Palette.line;
                background: Palette.surface;
                // Clicks on the card do not close it.
                TouchArea {}
                picker-list := VerticalLayout {
                    padding: 16px;
                    spacing: 4px;
                    Text {
                        text: "Switch provider";
                        font-family: "Inter Display";
                        font-size: 18px;
                        font-weight: 700;
                        color: Palette.text;
                    }
                    Text {
                        text: "j/k to move · Enter to switch · Esc to close";
                        font-size: 12px;
                        color: Palette.dim;
                    }
                    Rectangle {
                        height: 8px;
                    }
                    for p[i] in providers : Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: i == picker-selected ? Palette.accent-dim : transparent;
                        border-width: i == picker-selected ? 1px : 0px;
                        border-color: Palette.accent;
                        TouchArea {
                            clicked => { pick-provider(i); }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            // The last row adds a provider: no number.
                            Text {
                                width: 16px;
                                text: i < 9 && i < providers.length - 1 ? i + 1 : "";
                                font-size: 12px;
                                color: Palette.dim;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: p.name;
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: Palette.text;
                                    overflow: elide;
                                }
                                if p.note != "" : Text {
                                    text: p.note;
                                    font-size: 12px;
                                    color: Palette.dim;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }
        // The refresh panel: bottom right, above the status bar, over the
        // screen without blocking it. Left of the detail panel, so it does
        // not cover Recently played; 0 px wide in search and manage mode.
        if refresh-panel-open && refresh-stages.length > 0 && !first-run : Rectangle {
            x: parent.width - (guide-open ? 0px : detail-pane.width) - self.width - 16px;
            y: status-bar.y - self.height - 12px;
            width: 300px;
            height: stages-body.preferred-height;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.line;
            background: Palette.surface;
            drop-shadow-blur: 16px;
            drop-shadow-color: #0008;
            // Clicks on the card do not reach the list under it.
            TouchArea {}
            stages-body := VerticalLayout {
                padding: 14px;
                padding-top: 10px;
                spacing: 6px;
                HorizontalLayout {
                    Text {
                        text: "Refresh";
                        font-family: "Inter Display";
                        font-size: 14px;
                        font-weight: 700;
                        color: Palette.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: stages-close.has-hover ? Palette.line : Palette.surface;
                        stages-close := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { close-refresh(); }
                        }
                        Text {
                            text: "×";
                            font-size: 15px;
                            color: stages-close.has-hover ? Palette.text : Palette.dim;
                        }
                    }
                }
                for stage in refresh-stages : VerticalLayout {
                    spacing: 2px;
                    HorizontalLayout {
                        height: 20px;
                        spacing: 10px;
                        padding-left: stage.source ? 10px : 0px;
                        Text {
                            width: stage.source ? 110px : 72px;
                            text: stage.name;
                            font-size: stage.source ? 12px : 13px;
                            color: stage.source ? Palette.dim : Palette.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: stage.state;
                            font-size: 13px;
                            color: stage.tone == StageTone.running ? Palette.accent
                                : stage.tone == StageTone.done ? Palette.ok
                                : stage.tone == StageTone.warn ? Palette.warn
                                : Palette.dim;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    if stage.reason != "" : HorizontalLayout {
                        padding-left: 82px;
                        Text {
                            // Fixed, so the card's height counts the
                            // wrapped lines: 300 less padding and names.
                            width: 190px;
                            text: stage.reason;
                            horizontal-alignment: right;
                            font-size: 12px;
                            color: Palette.warn;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
        // `i` or the status bar's account: the account dashboard.
        if account-open : Rectangle {
            background: #0009;
            TouchArea {
                clicked => { close-account(); }
            }
            Rectangle {
                width: 480px;
                height: account-body.preferred-height;
                border-radius: 14px;
                border-width: 1px;
                border-color: Palette.line;
                background: Palette.surface;
                // Clicks on the card do not close it.
                TouchArea {}
                account-body := VerticalLayout {
                    padding: 20px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: account.title;
                                font-family: "Inter Display";
                                font-size: 20px;
                                font-weight: 700;
                                color: Palette.text;
                                overflow: elide;
                            }
                            Text {
                                text: account.note;
                                font-size: 12px;
                                color: Palette.dim;
                            }
                        }
                        if account.status != "" : VerticalLayout {
                            alignment: start;
                            padding-top: 3px;
                            Chip {
                                text: "● " + account.status;
                                ink: account.ok ? Palette.ok : Palette.danger;
                                fill: account.ok ? #6fcf9722 : #ef6b6b22;
                            }
                        }
                        VerticalLayout {
                            alignment: start;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 7px;
                                background: close-area.has-hover ? Palette.line : Palette.surface-2;
                                close-area := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { close-account(); }
                                }
                                Text {
                                    text: "×";
                                    font-size: 16px;
                                    color: close-area.has-hover ? Palette.text : Palette.dim;
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 8px;
                    }
                    if account.message != "" : Rectangle {
                        border-radius: 8px;
                        background: Palette.accent-dim;
                        height: message-text.preferred-height + 20px;
                        message-text := Text {
                            x: 12px;
                            width: parent.width - 24px;
                            text: account.message;
                            font-size: 12px;
                            color: Palette.text;
                            wrap: word-wrap;
                        }
                    }
                    if account.message != "" : Rectangle {
                        height: 6px;
                    }
                    SectionHeading {
                        text: "SUBSCRIPTION";
                    }
                    if account.expires != "" : InfoRow {
                        label: "Expires";
                        value: account.expires;
                    }
                    if account.created != "" : InfoRow {
                        label: "Created";
                        value: account.created;
                    }
                    if account.trial != "" : InfoRow {
                        label: "Trial";
                        value: account.trial;
                    }
                    if account.connections != "" : InfoRow {
                        label: "Connections";
                        value: account.connections;
                    }
                    if account.formats != "" : InfoRow {
                        label: "Stream formats";
                        value: account.formats;
                    }
                    if account.timezone != "" || account.server-time != "" || account.ports != "" || account.protocol != "" : VerticalLayout {
                        spacing: 6px;
                        Rectangle {
                            height: 0px;
                        }
                        SectionHeading {
                            text: "SERVER";
                        }
                        if account.timezone != "" : InfoRow {
                            label: "Timezone";
                            value: account.timezone;
                        }
                        if account.server-time != "" : InfoRow {
                            label: "Server time";
                            value: account.server-time;
                        }
                        if account.ports != "" : InfoRow {
                            label: "Ports";
                            value: account.ports;
                        }
                        if account.protocol != "" : InfoRow {
                            label: "Protocol";
                            value: account.protocol;
                        }
                    }
                    Rectangle {
                        height: 6px;
                    }
                    SectionHeading {
                        text: "LOGIN";
                    }
                    SecretRow {
                        label: "Server";
                        key: "1";
                        value: account-server;
                        clicked => { reveal(0); }
                    }
                    SecretRow {
                        label: "Username";
                        key: "2";
                        value: account-username;
                        clicked => { reveal(1); }
                    }
                    SecretRow {
                        label: "Password";
                        key: "3";
                        value: account-password;
                        clicked => { reveal(2); }
                    }
                }
            }
        }
        // `v`: scheduled, running and finished recordings. Hidden, not
        // conditional, so `show-recording` can reach its list; the lines are
        // empty while closed.
        Rectangle {
            visible: recordings-open;
            background: #0009;
            TouchArea {
                clicked => { close-recordings(); }
            }
            Rectangle {
                width: min(680px, parent.width - 48px);
                height: min(640px, parent.height - 64px);
                border-radius: 14px;
                border-width: 1px;
                border-color: Palette.line;
                background: Palette.surface;
                // Clicks on the card do not close it.
                TouchArea {}
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        VerticalLayout {
                            spacing: 8px;
                            horizontal-stretch: 1;
                            // A filler beside the switch, so its fixed width
                            // does not narrow the hint line below.
                            HorizontalLayout {
                                Rectangle {
                                    width: 260px;
                                    height: 34px;
                                    border-radius: 8px;
                                    background: Palette.bg;
                                    HorizontalLayout {
                                        padding: 3px;
                                        spacing: 2px;
                                        for t[i] in ["Recordings", "Downloads"] : Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 6px;
                                            background: i == recordings-tab ? Palette.accent-dim
                                                : tab-area.has-hover ? #ffffff0f : transparent;
                                            tab-area := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { recordings-select-tab(i); }
                                            }
                                            Text {
                                                text: t;
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: i == recordings-tab ? Palette.accent : Palette.dim;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                            Text {
                                text: "Enter plays · x cancels · d deletes · o opens the folder · c clears · Tab " + (recordings-tab == 0 ? "downloads" : "recordings") + " · Esc to close";
                                font-size: 12px;
                                color: Palette.dim;
                                overflow: elide;
                            }
                        }
                        if recordings-can-clear : VerticalLayout {
                            alignment: start;
                            padding-right: 10px;
                            Rectangle {
                                width: recordings-clear-label.preferred-width + 24px;
                                height: 28px;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: recordings-clear-armed ? Palette.warn : Palette.line;
                                background: recordings-clear-area.pressed ? #ffffff1a : recordings-clear-area.has-hover ? #ffffff0f : transparent;
                                recordings-clear-area := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { clear-recordings(); }
                                }
                                recordings-clear-label := Text {
                                    text: "Clear";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: recordings-clear-armed ? Palette.warn : Palette.dim;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: start;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 7px;
                                background: recordings-close.has-hover ? Palette.line : Palette.surface-2;
                                recordings-close := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { close-recordings(); }
                                }
                                Text {
                                    text: "×";
                                    font-size: 16px;
                                    color: recordings-close.has-hover ? Palette.text : Palette.dim;
                                }
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        if recordings-open && recordings.length == 0 : Text {
                            text: recordings-tab == 0
                                ? "Nothing recorded yet.\nPress R while watching to record it, or on a programme in the guide to schedule it."
                                : "Nothing downloaded yet.\nPress d on a movie or episode to download it, or D for a whole season.";
                            font-size: 14px;
                            color: Palette.dim;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        recordings-list := ListView {
                            mouse-drag-pan-enabled: true;
                            for r[i] in recordings : Rectangle {
                                height: r.heading != "" ? 36px : 56px;
                                border-radius: 8px;
                                background: i == recordings-selected ? Palette.accent-dim : transparent;
                                border-width: i == recordings-selected ? 1px : 0px;
                                border-color: Palette.accent;
                                if r.heading != "" : SectionHeading {
                                    x: 12px;
                                    y: parent.height - self.height - 8px;
                                    text: r.heading;
                                }
                                if r.heading == "" : TouchArea {
                                    clicked => { recordings-select(i); }
                                    double-clicked => { recordings-play(i); }
                                }
                                if r.heading == "" : HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 16px;
                                    spacing: 14px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: r.title;
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: r.tone == RecTone.dim ? Palette.dim : Palette.text;
                                            overflow: elide;
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: r.sub;
                                                font-size: 12px;
                                                color: Palette.dim;
                                                overflow: elide;
                                                horizontal-stretch: 0;
                                            }
                                            if r.note != "" : Text {
                                                text: "· " + r.note;
                                                font-size: 12px;
                                                color: r.tone == RecTone.warn ? Palette.warn : Palette.dim;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        if r.progress >= 0 : Progress {
                                            value: r.progress;
                                        }
                                    }
                                    Text {
                                        property <bool> cancel-armed: r.id == recordings-armed;
                                        property <bool> delete-armed: r.id == recordings-delete-armed;
                                        property <bool> armed: cancel-armed || delete-armed;
                                        text: cancel-armed ? "Press x again to cancel"
                                            : delete-armed ? "Press d again to delete"
                                            : r.state;
                                        font-size: 13px;
                                        font-weight: r.tone == RecTone.recording || r.tone == RecTone.active || armed ? 600 : 400;
                                        color: armed || r.tone == RecTone.warn ? Palette.warn
                                            : r.tone == RecTone.recording ? Palette.danger
                                            : r.tone == RecTone.active ? Palette.accent
                                            : Palette.dim;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // `,` or the status bar's gear: config.toml's settings.
        if settings-open : Rectangle {
            // The setup screen's logo above the card, as on the first-run
            // screen, and the card only as tall as what it holds.
            property <length> logo-space: setup-open ? 112px + 14px : 0px;
            background: setup-open ? Palette.bg : #0009;
            TouchArea {
                clicked => { close-settings(); }
            }
            if setup-open : Image {
                source: @image-url("../assets/vidicon.svg");
                x: 0;
                y: settings-card.y - parent.logo-space;
                width: parent.width;
                height: 112px;
                image-fit: contain;
            }
            settings-card := Rectangle {
                width: min(760px, parent.width - 48px);
                height: setup-open
                    ? min(settings-body.preferred-height, parent.height - 64px - parent.logo-space)
                    : min(560px, parent.height - 64px);
                y: (parent.height - self.height + parent.logo-space) / 2;
                border-radius: 14px;
                border-width: 1px;
                border-color: Palette.line;
                background: Palette.surface;
                // Clicks on the card do not close it.
                TouchArea {}
                settings-body := VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    HorizontalLayout {
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: setup-open ? setup-title : "Settings";
                                font-family: "Inter Display";
                                font-size: 20px;
                                font-weight: 700;
                                color: Palette.text;
                            }
                            Text {
                                text: settings-hint;
                                font-size: 12px;
                                color: Palette.dim;
                            }
                        }
                        if !setup-open : VerticalLayout {
                            alignment: start;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 7px;
                                background: settings-close.has-hover ? Palette.line : Palette.surface-2;
                                settings-close := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { close-settings(); }
                                }
                                Text {
                                    text: "×";
                                    font-size: 16px;
                                    color: settings-close.has-hover ? Palette.text : Palette.dim;
                                }
                            }
                        }
                    }
                    if setup-open && setup-text != "" : Text {
                        text: setup-text;
                        font-size: 14px;
                        color: Palette.text;
                        wrap: word-wrap;
                    }
                    if settings-note != "" : Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        background: #e8a86b1f;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: settings-note;
                                font-size: 13px;
                                color: Palette.warn;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 20px;
                        if !setup-open : VerticalLayout {
                            width: 170px;
                            spacing: 2px;
                            alignment: start;
                            for section[i] in settings-sections : Rectangle {
                                height: 34px;
                                border-radius: 8px;
                                background: i != settings-section ? (section-area.has-hover ? #ffffff0f : transparent)
                                    : settings-in-fields ? Palette.surface-2 : Palette.accent-dim;
                                border-width: i == settings-section && !settings-in-fields ? 1px : 0px;
                                border-color: Palette.accent;
                                section-area := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { settings-select-section(i); }
                                }
                                Text {
                                    x: 12px;
                                    text: section;
                                    font-size: 14px;
                                    font-weight: i == settings-section ? 600 : 400;
                                    color: i == settings-section ? Palette.text : Palette.dim;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if !setup-open : Rectangle {
                            width: 1px;
                            background: Palette.line;
                        }
                        // Scrolls when the fields outgrow the card (a guide
                        // source's form, many sources), keeping the
                        // selected one in view. The wheel scrolls it; a
                        // mouse drag does not, as it moves a guide source.
                        fields-flick := Flickable {
                            horizontal-stretch: 1;
                            // A wrapped note is taller than the column's
                            // preferred height counts: room for a few lines.
                            content-height: fields-column.preferred-height + 48px;
                            // The field from `top` to `bottom` scrolled into view.
                            function show(top: length, bottom: length) {
                                if top + self.content-y < 0 {
                                    self.content-y = -top;
                                } else if bottom + self.content-y > self.height {
                                    self.content-y = min(0px, self.height - bottom);
                                }
                            }
                            fields-column := VerticalLayout {
                                width: fields-flick.width;
                                spacing: 4px;
                                alignment: start;
                                if settings-fields.length == 0 : Text {
                                    text: "Nothing here yet.";
                                    font-size: 14px;
                                    color: Palette.dim;
                                }
                                for field[i] in settings-fields : Rectangle {
                                    property <bool> selected: settings-in-fields && i == settings-field;
                                    property <bool> choosing: i == settings-field && settings-choosing >= 0;
                                    // A new row (a form opening) starts at the
                                // top; its place, once laid out, moves it.
                                init => { if selected { fields-flick.show(self.y, self.y + self.height); } }
                                changed selected => { if selected { fields-flick.show(self.y, self.y + self.height); } }
                                    changed y => { if selected { fields-flick.show(self.y, self.y + self.height); } }
                                    changed height => { if selected { fields-flick.show(self.y, self.y + self.height); } }
                                    border-radius: 8px;
                                    background: selected ? Palette.accent-dim : transparent;
                                    border-width: selected ? 1px : 0px;
                                    border-color: Palette.accent;
                                    // A press and an 8 px move drag the row; a
                                    // drag is not a click.
                                    TouchArea {
                                        property <bool> dragging;
                                        mouse-cursor: self.dragging ? MouseCursor.grabbing
                                            : field.kind == SettingKind.stepper ? MouseCursor.default : MouseCursor.pointer;
                                        clicked => {
                                            if !self.dragging {
                                                settings-select-field(i);
                                            }
                                        }
                                        moved => {
                                            if self.pressed && abs(self.mouse-y - self.pressed-y) > 8px {
                                                self.dragging = true;
                                            }
                                        }
                                        pointer-event(e) => {
                                            if e.kind == PointerEventKind.down {
                                                self.dragging = false;
                                            }
                                            if e.kind == PointerEventKind.up && self.dragging {
                                                settings-drag(i, round((self.mouse-y - self.pressed-y) / (parent.height + 4px)));
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            spacing: 16px;
                                            VerticalLayout {
                                                spacing: 3px;
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                Text {
                                                    text: field.label;
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                    color: Palette.text;
                                                }
                                                Text {
                                                    text: field.note;
                                                    font-size: 12px;
                                                    color: Palette.dim;
                                                    // A removal's counts take two lines (onboarding ticket 02).
                                                    wrap: word-wrap;
                                                }
                                            }
                                            // Typed into below while edited.
                                            if field.kind == SettingKind.text || field.kind == SettingKind.row : Text {
                                                text: field.value;
                                                font-size: 13px;
                                                color: selected && settings-editing ? Palette.dim : Palette.text;
                                                vertical-alignment: center;
                                                horizontal-alignment: right;
                                                overflow: elide;
                                                max-width: 220px;
                                            }
                                            if field.reveal != "" : VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 52px;
                                                    height: 26px;
                                                    border-radius: 6px;
                                                    background: reveal-area.has-hover ? Palette.line : Palette.bg;
                                                    reveal-area := TouchArea {
                                                        mouse-cursor: MouseCursor.pointer;
                                                        clicked => { settings-reveal(); }
                                                    }
                                                    Text {
                                                        text: field.reveal;
                                                        font-size: 12px;
                                                        color: Palette.dim;
                                                    }
                                                }
                                            }
                                            // − and + a minute, each saved.
                                            if field.kind == SettingKind.stepper : VerticalLayout {
                                                alignment: center;
                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    Rectangle {
                                                        width: 32px;
                                                        height: 32px;
                                                        border-radius: 8px;
                                                        background: minus-area.has-hover ? Palette.line : Palette.bg;
                                                        minus-area := TouchArea {
                                                            mouse-cursor: MouseCursor.pointer;
                                                            clicked => { settings-step(i, -1); }
                                                        }
                                                        Text {
                                                            text: "−";
                                                            font-size: 15px;
                                                            color: field.chosen > 0 ? Palette.text : Palette.dim;
                                                        }
                                                    }
                                                    Text {
                                                        width: 64px;
                                                        text: field.value;
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        color: Palette.text;
                                                        vertical-alignment: center;
                                                        horizontal-alignment: center;
                                                    }
                                                    Rectangle {
                                                        width: 32px;
                                                        height: 32px;
                                                        border-radius: 8px;
                                                        background: plus-area.has-hover ? Palette.line : Palette.bg;
                                                        plus-area := TouchArea {
                                                            mouse-cursor: MouseCursor.pointer;
                                                            clicked => { settings-step(i, 1); }
                                                        }
                                                        Text {
                                                            text: "+";
                                                            font-size: 15px;
                                                            color: field.chosen < 60 ? Palette.text : Palette.dim;
                                                        }
                                                    }
                                                }
                                            }
                                            // A switch between the options: a click
                                            // on one saves it.
                                            if field.kind == SettingKind.toggle : VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 140px;
                                                    height: 32px;
                                                    border-radius: 8px;
                                                    background: Palette.bg;
                                                    HorizontalLayout {
                                                        padding: 3px;
                                                        spacing: 2px;
                                                        for option[j] in field.options : Rectangle {
                                                            horizontal-stretch: 1;
                                                            border-radius: 6px;
                                                            background: j == field.chosen ? Palette.accent-dim
                                                                : option-area.has-hover ? #ffffff0f : transparent;
                                                            option-area := TouchArea {
                                                                mouse-cursor: MouseCursor.pointer;
                                                                clicked => { settings-choose(i, j); }
                                                            }
                                                            Text {
                                                                text: option;
                                                                font-size: 13px;
                                                                font-weight: 600;
                                                                color: j == field.chosen ? Palette.accent : Palette.dim;
                                                                vertical-alignment: center;
                                                                horizontal-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if field.kind == SettingKind.choice : VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 200px;
                                                    height: 32px;
                                                    border-radius: 8px;
                                                    border-width: 1px;
                                                    border-color: choosing ? Palette.accent : Palette.line;
                                                    background: Palette.bg;
                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 10px;
                                                        Text {
                                                            text: field.value;
                                                            font-size: 13px;
                                                            color: Palette.text;
                                                            vertical-alignment: center;
                                                            overflow: elide;
                                                            horizontal-stretch: 1;
                                                        }
                                                        Text {
                                                            text: "▾";
                                                            font-size: 12px;
                                                            color: Palette.dim;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        // The open picker: its options, the
                                        // highlighted one in accent.
                                        if choosing : VerticalLayout {
                                            spacing: 2px;
                                            for option[j] in field.options : Rectangle {
                                                height: 30px;
                                                border-radius: 6px;
                                                background: j == settings-choosing ? Palette.accent-dim
                                                    : choice-area.has-hover ? #ffffff0f : transparent;
                                                choice-area := TouchArea {
                                                    mouse-cursor: MouseCursor.pointer;
                                                    clicked => { settings-choose(i, j); }
                                                }
                                                Text {
                                                    x: 10px;
                                                    text: (j == field.chosen ? "✓  " : "    ") + option;
                                                    font-size: 13px;
                                                    color: j == settings-choosing ? Palette.accent : Palette.text;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                        // The text being typed, with a caret.
                                        if selected && settings-editing : Rectangle {
                                            height: 32px;
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: Palette.accent;
                                            background: Palette.bg;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                Text {
                                                    text: settings-text + "▏";
                                                    font-size: 13px;
                                                    color: Palette.text;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                        if field.error != "" : HorizontalLayout {
                                            spacing: 10px;
                                            Text {
                                                text: field.error;
                                                font-size: 12px;
                                                color: Palette.warn;
                                                wrap: word-wrap;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                            if field.button != "" : Rectangle {
                                                width: max(76px, button-text.preferred-width + 20px);
                                                height: 26px;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: Palette.warn;
                                                background: create-area.has-hover ? #e8a86b1f : transparent;
                                                create-area := TouchArea {
                                                    mouse-cursor: MouseCursor.pointer;
                                                    clicked => { settings-button(); }
                                                }
                                                button-text := Text {
                                                    text: field.button;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    color: Palette.warn;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // The guide card (EPG sources ticket 05), over Settings too, as
        // its ambiguous list opens from there. Hidden, not conditional, so
        // `show-card-selected` can reach its list.
        Rectangle {
            visible: card-open;
            background: #0009;
            TouchArea {
                clicked => { close-card(); }
            }
            Rectangle {
                width: min(560px, parent.width - 48px);
                height: min(520px, parent.height - 64px);
                border-radius: 14px;
                border-width: 1px;
                border-color: Palette.line;
                background: Palette.surface;
                // Clicks on the card do not close it.
                TouchArea {}
                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    Text {
                        text: card-title;
                        font-family: "Inter Display";
                        font-size: 18px;
                        font-weight: 700;
                        color: Palette.text;
                        overflow: elide;
                    }
                    Text {
                        text: card-hint;
                        font-size: 12px;
                        color: Palette.dim;
                        overflow: elide;
                    }
                    if card-query-shown : Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Palette.accent;
                        background: Palette.bg;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: card-query + "▏";
                                font-size: 14px;
                                color: Palette.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    Rectangle {
                        height: 4px;
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        if card-open && card-rows.length == 0 : Text {
                            text: card-empty;
                            font-size: 14px;
                            color: Palette.dim;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        card-list := ListView {
                            mouse-drag-pan-enabled: true;
                            for r[i] in card-rows : Rectangle {
                                height: card-row-height;
                                border-radius: 8px;
                                background: i == card-selected ? Palette.accent-dim : transparent;
                                border-width: i == card-selected ? 1px : 0px;
                                border-color: Palette.accent;
                                TouchArea {
                                    clicked => { card-clicked(i); }
                                    double-clicked => { card-activated(i); }
                                }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: r.label;
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: Palette.text;
                                            overflow: elide;
                                        }
                                        if r.note != "" : Text {
                                            text: r.note;
                                            font-size: 12px;
                                            color: r.warn ? Palette.warn : Palette.dim;
                                            overflow: elide;
                                        }
                                    }
                                    if r.mark != "" : Text {
                                        text: r.mark;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Palette.accent;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }
                                    if r.action != "" : Rectangle {
                                        width: 64px;
                                        height: 28px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 14px;
                                        border-width: 1px;
                                        border-color: Palette.line;
                                        background: card-action-area.pressed ? #ffffff1a : card-action-area.has-hover ? #ffffff0f : transparent;
                                        card-action-area := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { card-action(i); }
                                        }
                                        Text {
                                            text: r.action;
                                            font-size: 12px;
                                            color: Palette.text;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // `?`: every key, grouped. Hidden, not conditional, so
        // `scroll-keys` can reach its Flickable.
        Rectangle {
            visible: keys-open;
            background: #0009;
            TouchArea {
                clicked => { close-keys(); }
            }
            Rectangle {
                // As big as the keys need, to the window's edges less a
                // margin; past them the keys scroll under the heading.
                width: min(keys-content.preferred-width + 40px, parent.width - 48px);
                height: min(keys-head.preferred-height + keys-content.preferred-height + 54px, parent.height - 64px);
                border-radius: 14px;
                border-width: 1px;
                border-color: Palette.line;
                background: Palette.surface;
                // Clicks on the card do not close it.
                TouchArea {}
                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    keys-head := HorizontalLayout {
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: "Keys";
                                font-family: "Inter Display";
                                font-size: 20px;
                                font-weight: 700;
                                color: Palette.text;
                            }
                            Text {
                                text: "Esc to close";
                                font-size: 12px;
                                color: Palette.dim;
                            }
                        }
                        VerticalLayout {
                            alignment: start;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 7px;
                                background: keys-close.has-hover ? Palette.line : Palette.surface-2;
                                keys-close := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { close-keys(); }
                                }
                                Text {
                                    text: "×";
                                    font-size: 16px;
                                    color: keys-close.has-hover ? Palette.text : Palette.dim;
                                }
                            }
                        }
                    }
                    keys-flick := Flickable {
                        vertical-stretch: 1;
                        content-width: keys-content.width;
                        content-height: keys-content.height;
                        keys-content := VerticalLayout {
                            // Columns shrink to their minimum before it scrolls across.
                            width: max(keys-flick.width, self.min-width);
                            height: self.preferred-height;
                            spacing: 14px;
                            HorizontalLayout {
                                spacing: 32px;
                                for column in key-columns : VerticalLayout {
                                    min-width: 300px;
                                    preferred-width: 350px;
                                    horizontal-stretch: 1;
                                    spacing: 14px;
                                    alignment: start;
                                    for group in column.groups : VerticalLayout {
                                        spacing: 4px;
                                        SectionHeading {
                                            text: group.title;
                                        }
                                        for row in group.rows : HorizontalLayout {
                                            height: 28px;
                                            spacing: 12px;
                                            HorizontalLayout {
                                                width: 140px;
                                                spacing: 4px;
                                                alignment: start;
                                                for key in row.keys : VerticalLayout {
                                                    alignment: center;
                                                    Keycap {
                                                        text: key;
                                                    }
                                                }
                                            }
                                            Text {
                                                text: row.action;
                                                font-size: 13px;
                                                color: Palette.dim;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                height: 1px;
                                background: Palette.line;
                            }
                            VerticalLayout {
                                spacing: 4px;
                                SectionHeading {
                                    text: "IN OTHER VIEWS";
                                }
                                for note in key-notes : HorizontalLayout {
                                    height: 24px;
                                    spacing: 12px;
                                    Text {
                                        width: 150px;
                                        text: note.view;
                                        font-size: 13px;
                                        color: Palette.text;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: note.text;
                                        font-size: 13px;
                                        color: Palette.dim;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
